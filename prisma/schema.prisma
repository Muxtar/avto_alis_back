generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserType {
  CAR_OWNER
  MECHANIC
  PARTS_SELLER
  COURIER
}

enum UserRole {
  USER
  ADMIN
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ListingType {
  PRODUCT
  SERVICE
}

// Elan moderasiyası — yeni elan admin təsdiqindən sonra saytda görünür.
// Default APPROVED-dur ki, `db push` zamanı MÖVCUD elanlar itməsin;
// yeni elanlar yaradılanda status açıq şəkildə PENDING qoyulur.
enum ListingStatus {
  PENDING // gözləmədə — yalnız sahibi və admin görür
  APPROVED // təsdiqlənib — saytda görünür
  REJECTED // rədd edilib — sahibi səbəbi görür
  // Obyekt/biznes silinəndə elan bu statusa keçir. Sətir BAZADA QALIR, çünki
  // OrderItem.listingId FK-sı Cascade-dir: elanı həqiqətən silsək satılmış
  // məhsulun sifariş sətri də silinər və "kim nə aldı, kimə nə qədər borcluyuq"
  // tarixçəsi itərdi. Bütün ictimai sorğular `status = APPROVED` tələb etdiyi
  // üçün ARCHIVED elan saytın heç bir yerində görünmür.
  ARCHIVED
}

enum BookingType {
  RESERVATION // restoran/masa/məkan — tarix + saat + nəfər
  STAY // otel/bağ evi/günlük kirayə — giriş-çıxış tarixi
}

enum BookingStatus {
  PENDING // sahibin təsdiqini gözləyir
  CONFIRMED // sahib təsdiqlədi
  REJECTED // sahib rədd etdi
  CANCELLED // qonaq ləğv etdi
  COMPLETED // baş tutdu / keçmişdə qaldı
}

enum Condition {
  NEW
  USED
  REFURBISHED
}

enum FuelType {
  GASOLINE
  DIESEL
  HYBRID
  ELECTRIC
  GAS
  OTHER
}

enum PaymentType {
  CASH
  CREDIT
  BOTH
}

enum OrderStatus {
  PENDING
  CONFIRMED
  SHIPPED
  DELIVERED
  CANCELLED
}

enum DeliveryType {
  DELIVERY
  PICKUP
}

// Çatdırılma kim tərəfindən olunur (satıcı seçir, VÖEN elanlarda):
// COURIER = kuryer (Yango) ilə; SELF = satıcı özü çatdırır.
enum DeliveryMethod {
  COURIER
  SELF
}

enum PaymentMethod {
  CASH
  CARD
  WALLET
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum ReturnStatus {
  REQUESTED
  APPROVED
  REJECTED
  RETURN_SHIPPED
  RETURN_RECEIVED
  REFUNDED
  CANCELLED
}

enum ReturnReason {
  DEFECTIVE
  WRONG_ITEM
  NOT_AS_DESCRIBED
  CHANGED_MIND
  OTHER
}

model User {
  id            Int      @id @default(autoincrement())
  name          String   @default("")
  phone         String
  email         String?
  emailVerified Boolean  @default(false) // email doğrulama kodu ilə təsdiqlənib
  telegramId    String?  @unique
  type          UserType @default(CAR_OWNER)
  role          UserRole @default(USER)
  // Admin icazə modulları (RBAC) — məs. ["listings","orders"]. Super-admin
  // (ADMIN_PHONES) bu siyahıdan asılı olmadan hər şeyə girə bilir; adi adminlər
  // yalnız burada sadalanan modullara. role=ADMIN olmayanlarda mənasızdır.

  // ADMIN GİRİŞİNİN KİLİDLƏNMƏSİ — ardıcıl səhv kod cəhdləri sayılır.
  // Limit aşılanda hesab müəyyən müddət kilidlənir (IP limitindən asılı deyil,
  // ona görə fərqli IP-lərdən yavaş hücum da dayanır).
  adminFailedLogins     Int                   @default(0)
  adminLockedUntil      DateTime?
  adminPermissions      String[]              @default([])
  password              String?
  verified              Boolean               @default(false)
  isBlocked             Boolean               @default(false) // admin tərəfindən bloklanıb
  profileComplete       Boolean               @default(false)
  lastSeen              DateTime? // sonuncu onlayn olduğu vaxt (offline olanda "son görülmə")
  profession            String? // əsas ixtisas (professions[0] — geriyə uyğunluq üçün)
  professions           String[]              @default([]) // 3-ə qədər ixtisas
  bio                   String? // istifadəçinin özü haqqında qeydi
  avatar                String? // profil şəkli
  cvFile                String? // istifadəçinin CV-si (PDF/şəkil)
  cvPublic              Boolean               @default(false) // CV public profildə görünsünmü
  idNumber              String? // kimlik / FIN (köhnə — indi şəkil istənir)
  birthDate             DateTime? // doğum tarixi (vəsiqədən AI ilə)
  gender                String? // cinsiyyət (vəsiqədən AI ilə: "Kişi"/"Qadın")
  idCardImage           String? // şəxsiyyət vəsiqəsi ön tərəf
  idCardBackImage       String? // şəxsiyyət vəsiqəsi arxa tərəf (yalnız sahibi görür)
  selfieImage           String? // selfie — ön (qarşıdan, üz tanıma üçün)
  selfieRightImage      String? // selfie — sağ profil
  selfieLeftImage       String? // selfie — sol profil
  faceMatchScore        Float? // face-api.js oxşarlıq balı (0–1, brauzerdə)
  // Claude AI kimlik doğrulaması (vəsiqədəki ad + üz uyğunluğu)
  idAiNameMatch         Boolean? // vəsiqədəki ad qeydiyyatla uyğun?
  idAiNameScore         Float? // 0..1
  idAiFaceMatch         Boolean? // vəsiqə fotosu ilə selfie eyni şəxs?
  idAiFaceScore         Float? // 0..1
  idAiReason            String? // AI-ın qısa izahı
  idVerifyStatus        VerificationStatus? // null=təqdim olunmayıb, PENDING=admin gözləyir
  // Veriff (peşəkar KYC) inteqrasiyası — konfiqurasiya olunanda istifadə edilir
  veriffSessionId       String? // son Veriff sessiyası
  veriffStatus          String? // Veriff-in xam statusu (approved/declined/resubmission_requested...)
  sellerVerified        Boolean               @default(false) // ≥1 təsdiqlənmiş biznesi var
  sellerVerifiedAt      DateTime?
  sellerApplication     SellerVerification?
  businesses            Business[]
  businessMemberships   BusinessMember[]      @relation("BusinessMemberships")
  consultationOffers    ConsultationOffer[]   @relation("UserConsultationOffer")
  consultationsBought   ConsultationSession[] @relation("ConsultationBuyer")
  consultationsSelling  ConsultationSession[] @relation("ConsultationProfessional")
  consultationSuspended Boolean               @default(false) // admin Rəy təkliflərini dayandırıb
  complaintFlags        Int                   @default(0) // təsdiqlənmiş şikayət sayı
  complaintsMade        Complaint[]           @relation("ComplaintsMade")
  complaintsAgainst     Complaint[]           @relation("ComplaintsAgainst")
  publicId              String?               @unique // hər kəsə verilən xüsusi ID (profildə)
  createdAt             DateTime              @default(now())
  vehicles              Vehicle[]
  workplaces            Workplace[]
  verificationCodes     VerificationCode[]
  listings              Listing[]
  sentMessages          Message[]             @relation("SentMessages")
  receivedMessages      Message[]             @relation("ReceivedMessages")
  comments              Comment[]
  cart                  Cart?
  buyerOrders           Order[]               @relation("BuyerOrders")
  sellerOrders          Order[]               @relation("SellerOrders")
  courierOrders         Order[]               @relation("CourierOrders")
  referralOrders        Order[]               @relation("ReferralOrders")
  referralCarts         ReferralCart[]        @relation("ReferralCarts")
  emailVerifications    EmailVerification[]
  socialLinks           SocialLink[]
  outreachRequests      SocialOutreach[]      @relation("OutreachRequests")
  professionDocuments   ProfessionDocument[]
  phones                PhoneNumber[]
  sharedCarts           SharedCart[]
  buyerReturns          ReturnRequest[]       @relation("BuyerReturns")
  sellerReturns         ReturnRequest[]       @relation("SellerReturns")
  buyerInquiries        Inquiry[]             @relation("BuyerInquiries")
  targetedInquiries     InquiryTarget[]       @relation("TargetedInquiries")
  sellerOffers          InquiryOffer[]        @relation("SellerOffers")

  // Bolt Food benzeri ozellikler
  loyaltyPoints Int            @default(0)
  isPremium     Boolean        @default(false)
  premiumUntil  DateTime?
  avgRating     Float? // satici icin ortalama rating
  ratingCount   Int            @default(0)
  businessHours Json? // {monday: {open: "09:00", close: "18:00"}, ...}
  favorites     Favorite[]
  addresses     SavedAddress[]
  sellerRatings SellerRating[] @relation("SellerRatings")
  givenRatings  SellerRating[] @relation("BuyerRatings")
  guestBookings Booking[]      @relation("GuestBookings")
  hostBookings  Booking[]      @relation("HostBookings")
  contacts      Contact[]      @relation("OwnContacts")
  blockedUsers  BlockedUser[]  @relation("Blocker") // mənim bloklağım
  blockedBy     BlockedUser[]  @relation("Blocked") // məni bloklayanlar
  notifications Notification[]
  sessions      Session[]      @relation("UserSessions")
  savedCards    SavedCard[]
  consents      UserConsent[]
  businessFees  BusinessFee[]

  // Default location — used on listings + city-search browsing.
  city      String?
  address   String?
  latitude  Float?
  longitude Float?

  // Usta / satıcı ixtisası — hansı avtomobil markaları və hansı hissə
  // kateqoriyaları üzrə xidmət göstərir (MECHANIC / PARTS_SELLER üçün).
  serviceBrands     String[] @default([]) // seçilmiş marka adları (məs. ["BMW", "Mercedes-Benz"])
  serviceAllBrands  Boolean  @default(false) // bütün markalarla işləyir
  serviceCategories String[] @default([]) // seçilmiş hissə id-ləri (bax: sellerCategories.ts)

  @@index([phone])
  @@index([type])
  @@index([createdAt])
  @@index([city])
}

model Vehicle {
  id     Int    @id @default(autoincrement())
  userId Int
  brand  String
  model  String
  year   Int

  // Backwards-compatible legacy single-image field. New rows use the
  // front/back pair below; old rows keep this populated.
  passportImage String @default("")

  // Texniki pasport şəkilləri (ön və arxa hissələr)
  passportImageFront String? // ön kart şəkli
  passportImageBack  String? // arxa kart şəkli

  // ===== Texniki pasportun ön hissəsi =====
  registrationNumber String? // A — Qeydiyyat nişanı (məs: 77NP518)
  registrationDate   String? // B.1 — Qeydiyyat tarixi (məs: 25.11.2024)
  manufactureYear    Int? // B.2 — İstehsal tarixi (il)
  ownerName          String? // C.1 — Mülkiyyətçi (məs: ƏSƏDOV EMIN ASLAN OĞLU)
  ownerAddress       String? // C.2 — Sahibinin ünvanı
  ownershipType      String? // C.3 — Mülkiyyət növü (Fiziki şəxs / Hüquqi şəxs)
  validUntil         String? // H — Etibarlıdır
  cardSerial         String? // Kart üzərindəki seriya (məs: BB667834)

  // ===== Texniki pasportun arxa hissəsi =====
  vehicleType    String? // D.3 — Tip (məs: MİNİK, UNIVERSAL)
  engineNumber   String? // E.1 — Mühərrik nömrəsi
  bodyNumber     String? // E.2 — Ban nömrəsi (VIN)
  chassisNumber  String? // E.3 — Şassi nömrəsi
  color          String? // E.4 — Rəngi
  maxMass        String? // F.1 — Maksimal kütlə
  unloadedMass   String? // F.2 — Yüksüz kütlə
  seatCount      Int? // F.3 — Oturacaqların sayı
  engineCapacity String? // G — Mühərrikin həcmi (sm³)
  issuedBy       String? // Verilib (məs: AR DİN BDYPİ Qİİ)
  specialMarks   String? // Xüsusi qeydlər

  // AI çıxarışı və metadata
  aiExtracted  Json? // AI-nın qaytardığı xam JSON (audit / debug üçün)
  aiVerifiedAt DateTime? // AI-nın oxuduğu vaxt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([registrationNumber])
  @@index([bodyNumber])
}

model Workplace {
  id        Int    @id @default(autoincrement())
  userId    Int
  name      String
  address   String
  latitude  Float?
  longitude Float?
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationCode {
  id        Int      @id @default(autoincrement())
  userId    Int
  code      String
  expiresAt DateTime
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// İstifadəçinin telefon nömrələri — biri əsas (user.phone), digərləri məlumat üçün.
// Hər nömrə doğrulama kodu ilə təsdiqlənir.
model PhoneNumber {
  id            Int       @id @default(autoincrement())
  userId        Int
  phone         String
  isPrimary     Boolean   @default(false) // əsas nömrə → user.phone + elanlardakı nömrə
  verified      Boolean   @default(false)
  code          String? // doğrulama kodu (təsdiqdən sonra təmizlənir)
  codeExpiresAt DateTime?
  createdAt     DateTime  @default(now())
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, phone])
  @@index([userId])
}

model Listing {
  id                Int             @id @default(autoincrement())
  userId            Int
  title             String
  description       String
  price             Float
  category          String
  type              ListingType
  images            String[]
  location          String?
  phone             String?
  condition         Condition       @default(NEW)
  // Elana özəl konum — hər elanın öz xəritə nöqtəsi ola bilər (məs. ayrı-ayrı ev/mənzil).
  // Yoxdursa satıcının default konumu istifadə olunur.
  latitude          Float?
  longitude         Float?
  country           String?
  brand             String?
  stock             Int             @default(1)
  forVehicle        String?
  unit              String?
  unitValue         Float?
  year              Int?
  model             String?
  city              String?
  fuelType          FuelType?
  attributes        Json? // kateqoriyaya xüsusi sahələr (otaq sayı, sahə, ölçü, yürüş...)
  paymentType       PaymentType?
  barter            Boolean         @default(false) // dəyiş-düş (barter) qəbul olunur
  forRent           Boolean         @default(false) // satış yox, icarə/kirayə
  // Bron / rezervasiya — restoran, otel, bağ evi, məkan və s. bron edilə bilər
  bookable          Boolean         @default(false)
  // Satıcı VÖEN elanda "məhsulu özüm də çatdıra bilərəm" seçimini aktiv edə bilər.
  // Yango (kuryer) və mağazadan götürmə həmişə mümkündür; bunu satıcı açır.
  allowSelfDelivery Boolean         @default(false)
  // Yalnız alıcı gəlib götürsün — Yango və satıcı çatdırması bağlıdır (məs. avtomobil).
  pickupOnly        Boolean         @default(false)
  // Satıcı özü çatdıranda qeyd/qiymət (məs. "Şəhər içi 10 AZN, kənar 20 AZN").
  selfDeliveryNote  String?
  // Məhsulun çəkisi (kq, bir ədəd). Yango yük limiti (50 kq) yoxlanışı üçün.
  weightKg          Float?
  bookingType       BookingType? // RESERVATION (tarix+saat) | STAY (giriş-çıxış)
  maxGuests         Int? // maksimum qonaq / nəfər sayı
  openTime          String? // rezervasiya üçün açılış saatı "10:00"
  closeTime         String? // rezervasiya üçün bağlanış saatı "23:00"
  viewCount         Int             @default(0)
  // Moderasiya — bax: ListingStatus. Default APPROVED (köhnə elanlar üçün),
  // yeni elanlar create zamanı PENDING olaraq yazılır.
  status            ListingStatus   @default(APPROVED)
  archivedAt        DateTime? // obyekt/biznes silinəndə arxivləşdirilib
  rejectReason      String? // rədd edilibsə səbəb (sahibi görür)
  reviewedAt        DateTime? // admin nə vaxt baxdı
  expiresAt         DateTime?
  // Biznes bağlantısı — elan bir obyektə (filiala) aiddirsə kart ödənişi mümkün olur.
  businessId        Int?
  businessObjectId  Int?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  business          Business?       @relation(fields: [businessId], references: [id], onDelete: SetNull)
  businessObject    BusinessObject? @relation(fields: [businessObjectId], references: [id], onDelete: SetNull)
  messages          Message[]
  comments          Comment[]
  cartItems         CartItem[]
  orderItems        OrderItem[]
  inquiryOffers     InquiryOffer[]
  favorites         Favorite[]
  bookings          Booking[]

  @@index([userId, createdAt])
  @@index([category])
  @@index([price])
  @@index([type])
  @@index([year])
  @@index([city])
  @@index([fuelType])
  @@index([paymentType])
  @@index([businessId])
  @@index([businessObjectId])
}

enum MessageType {
  TEXT
  IMAGE
  FILE
  AUDIO // səs mesajı
  VIDEO // video mesaj (video note)
  CONTACT // paylaşılan kontakt
  LOCATION // paylaşılan konum (xəritə)
  CALL // səsli/görüntülü zəng qeydi (chat-də mesaj kimi görünür)
}

model Message {
  id               Int                  @id @default(autoincrement())
  senderId         Int
  receiverId       Int? // 1:1 mesaj üçün alıcı; qrup mesajında null
  conversationId   Int? // qrup mesajı üçün; 1:1-də null
  listingId        Int?
  // Mesaj hansı BİZNES OBYEKTİNƏ (filial/mağaza) aiddir.
  // Yazılma anında elandan götürülür və SABİT qalır — elan sonradan başqa
  // obyektə köçürülsə, keçmiş mesajlar yanlış obyekti göstərməsin.
  // Obyektin əlaqə şəxsi bir neçə obyektə baxırsa, hansı filialdan gəldiyini
  // yalnız bu sahə ilə ayırd edə bilir.
  businessObjectId Int?
  // Mesaj İŞ (biznes) axınına aiddirmi. Adətən listingId/businessObjectId-dən
  // çıxarıla bilir, amma həmişə yox: sifariş səhifəsindən başlanan yazışmada
  // hələ məhsul konteksti olmur. Açıq sahə olmasa belə mesaj səssizcə şəxsi
  // söhbətə düşərdi. Köhnə sətirlərdə false-dur — onlar kontekstdən tanınır.
  isBusiness       Boolean              @default(false)
  consultationId   Int? // dolu olarsa bu mesaj "Rəy" konsultasiyasına aiddir (ayrı icon)
  content          String
  type             MessageType          @default(TEXT)
  mediaUrl         String? // yüklənmiş faylın adı (şəkil/fayl/audio/video)
  mediaName        String? // orijinal fayl adı, və ya paylaşılan kontaktın adı
  mediaMime        String?
  mediaSize        Int? // bayt
  mediaDuration    Int? // saniyə (audio/video)
  contactPhone     String? // paylaşılan kontaktın nömrəsi
  contactUserId    Int? // paylaşılan kontakt qeydiyyatlı istifadəçidirsə
  callKind         String? // CALL tipində: "audio" | "video"
  callStatus       String? // CALL tipində: "ANSWERED" | "MISSED" (müddət mediaDuration-da)
  latitude         Float? // paylaşılan konum (LOCATION)
  longitude        Float? // paylaşılan konum (LOCATION)
  read             Boolean              @default(false)
  deliveredAt      DateTime? // qarşı tərəf onlayn olub aldı (tək ✓ → ✓✓)
  editedAt         DateTime? // redaktə olunubsa
  deletedAt        DateTime? // "hamı üçün sil" — sətir qalır, mətn boşalır
  deletedForIds    Int[]                @default([]) // "yalnız məndə sil" — bu istifadəçilər üçün gizlədilib
  replyToId        Int? // cavab verilən mesaj
  createdAt        DateTime             @default(now())
  businessObject   BusinessObject?      @relation(fields: [businessObjectId], references: [id], onDelete: SetNull)
  sender           User                 @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiver         User?                @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)
  conversation     Conversation?        @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  listing          Listing?             @relation(fields: [listingId], references: [id], onDelete: SetNull)
  consultation     ConsultationSession? @relation(fields: [consultationId], references: [id], onDelete: SetNull)
  replyTo          Message?             @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies          Message[]            @relation("MessageReplies")
  reactions        MessageReaction[]

  @@index([businessObjectId])
  @@index([senderId, receiverId])
  @@index([receiverId, read])
  @@index([conversationId])
}

// Qrup söhbəti (WhatsApp qrupu kimi). 1:1 çat bu modeldən istifadə etmir.
model Conversation {
  id          Int                  @id @default(autoincrement())
  name        String
  avatar      String?
  createdById Int
  createdAt   DateTime             @default(now())
  members     ConversationMember[]
  messages    Message[]
}

model ConversationMember {
  id             Int          @id @default(autoincrement())
  conversationId Int
  userId         Int
  role           String       @default("MEMBER") // ADMIN | MEMBER
  joinedAt       DateTime     @default(now())
  lastReadAt     DateTime? // oxunmamış say üçün
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
}

// Mesaja emoji reaksiya — hər istifadəçi bir mesaja bir emoji (WhatsApp kimi).
model MessageReaction {
  id        Int      @id @default(autoincrement())
  messageId Int
  userId    Int
  emoji     String
  createdAt DateTime @default(now())
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([messageId])
}

// Rəy — məhsul (listing), obyekt (businessObject) və ya ixtisas/rəy profili (professionalUserId)
// haqqında. Dəqiq biri doldurulur. Bir istifadəçi bir hədəf üçün yalnız bir dəfə (tətbiqdə yoxlanır).
model Comment {
  id                 Int             @id @default(autoincrement())
  userId             Int
  listingId          Int? // məhsul rəyi
  objectId           Int? // obyekt rəyi
  professionalUserId Int? // ixtisas/rəy profili rəyi (hədəf istifadəçi id)
  content            String
  rating             Int?
  createdAt          DateTime        @default(now())
  user               User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing            Listing?        @relation(fields: [listingId], references: [id], onDelete: Cascade)
  object             BusinessObject? @relation(fields: [objectId], references: [id], onDelete: Cascade)

  @@index([listingId])
  @@index([objectId])
  @@index([professionalUserId])
}

model Cart {
  id        Int        @id @default(autoincrement())
  userId    Int        @unique
  createdAt DateTime   @default(now())
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
}

// Paylaşılan səbət — istifadəçi səbəti link kimi paylaşır, linki açan şəxs
// məhsulları öz səbətinə alıb sifariş verir (məhsuldan anlayan başqasına kömək edir).
model SharedCart {
  id              Int      @id @default(autoincrement())
  token           String   @unique
  userId          Int // yaradan
  title           String? // ixtiyari ad ("Anama hədiyyə" və s.)
  items           Json // [{ listingId, quantity }]
  // Çatdırılma rejimi: RECIPIENT = alıcı öz ünvanını seçir; SENDER = göndərənin (aşağıdakı) ünvanına gedir.
  deliveryMode    String   @default("RECIPIENT")
  address         String? // SENDER rejimində göndərənin çatdırılma ünvanı
  city            String?
  latitude        Float?
  longitude       Float?
  phone           String?
  // Məhsulu KİM alacaq. null → paylaşanın özü. Dost seçilibsə o, saytda
  // QEYDİYYATLI olmalıdır (ünvan/bildiriş/sifariş tarixçəsi ona bağlanır).
  // Ödəyən isə qeydiyyatlı olmaya bilər — link hamıya açıqdır.
  recipientUserId Int?
  // Bu linkdən yaradılmış sifarişlər — link təkrar ödənilməsin deyə yoxlanılır.
  orderIds        Int[]    @default([])
  createdAt       DateTime @default(now())
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model CartItem {
  id        Int     @id @default(autoincrement())
  cartId    Int
  listingId Int
  quantity  Int     @default(1)
  cart      Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([cartId, listingId])
}

model Order {
  id                  Int             @id @default(autoincrement())
  buyerId             Int
  sellerId            Int
  courierId           Int?
  status              OrderStatus     @default(PENDING)
  total               Float
  subtotal            Float? // indirim oncesi
  discountAmount      Float           @default(0)
  pointsEarned        Int             @default(0)
  pointsUsed          Int             @default(0)
  address             String?
  phone               String?
  note                String?
  deliveryType        DeliveryType    @default(DELIVERY)
  // Çatdırılma metodu (DELIVERY olduqda): kuryer (Yango) və ya satıcı özü — alıcı seçir.
  deliveryMethod      DeliveryMethod? @default(COURIER)
  deliveryFee         Float           @default(0) // Yango çatdırılma haqqı (alıcı ödəyir)
  // Biznes adına alış — canBuy səlahiyyətli işçi obyekt üçün alış edir.
  buyerObjectId       Int?
  // Təhvil kodu — alıcı ilə satıcı/kuryer arasında məhsulun düzgün təhvili üçün
  // unikal kod. Yalnız bu kod təsdiqlənəndə DELIVERED olur (səhv təhvilin qarşısını alır).
  pickupCode          String?
  // Yango (Yandex Delivery) inteqrasiyası
  yangoClaimId        String? // Yango claim id
  yangoStatus         String? // Yango status (new/accepted/performer_found/pickuped/delivered/cancelled...)
  yangoVersion        Int? // accept/cancel üçün lazım olan versiya
  yangoPrice          Float? // Yango çatdırılma qiyməti
  yangoCurrency       String?
  yangoError          String? // göndərmə uğursuz olsa səbəb (kuryer tapılmadı, ünvan yoxdur...)
  // Neçənci dəfə Yango-ya göndərilir. Ləğvdən sonra yenidən kuryer çağırmaq
  // üçün lazımdır: Yango sorğuları `request_id` üzrə təkrarlanandan qoruyur —
  // eyni id ilə yeni claim yaratmaq istəsək KÖHNƏ (ləğv edilmiş) claim qayıdır.
  // Sayğac hər yeni cəhddə artır, cəhd daxilində isə sabit qalır (təkrar
  // sorğu təhlükəsiz olsun).
  yangoAttempt        Int             @default(0)
  scheduledAt         DateTime? // ileri tarihli siparis
  paymentMethod       PaymentMethod   @default(CASH)
  paymentStatus       PaymentStatus   @default(PENDING)
  // Kapital Bank ödəniş şlüzü — kart ödənişində bir checkout-dakı bütün
  // order-lər eyni gatewayOrderId-ni paylaşır (müştəri bir dəfə ödəyir).
  gatewayOrderId      Int?
  gatewayPassword     String?
  gatewayStatus       String?
  gatewayProvider     String? // 'kapital' | 'yigim'
  gatewayRef          String? // şlüz referansı (YIĞIM: reference; Kapital: order id)
  gatewayCallbackAt   DateTime? // YIĞIM callback-inin gəldiyi an — get-payment YALNIZ bundan sonra çağırılır
  // "Paylaş — başqası ödəsin": sifarişi ÖDƏYƏN şəxs alıcıdan (buyerId) fərqlidir.
  // Ödəyən saytda qeydiyyatlı olmaya bilər, ona görə ad/telefon sahə kimi saxlanılır.
  sharedCartId        Int? // hansı paylaşım linkindən gəldi
  payerName           String?
  payerPhone          String?
  payerUserId         Int? // ödəyən qeydiyyatlıdırsa
  promoCodeId         Int?
  // Referal (komissiyalı) satış
  referrerId          Int? // sifarişi yönləndirən peşəkar
  referralPercent     Float? // tətbiq olunan komissiya faizi
  referralAmount      Float? // hesablanmış komissiya məbləği
  referralVoided      Boolean         @default(false) // qaytarma/refund-da komissiya ləğv edilib
  stockRestored       Boolean         @default(false) // ödəniş uğursuz olduqda stok yalnız bir dəfə geri qaytarılır (idempotentlik)
  hiddenForBuyer      Boolean         @default(false) // alıcı öz siyahısından gizlədib (sil)
  hiddenForSeller     Boolean         @default(false) // satıcı öz siyahısından gizlədib (sil)
  stockCommitted      Boolean         @default(false) // KART: stok ödəniş təsdiqlənəndə (PAID) bir dəfə azaldılır (idempotentlik)
  paidAt              DateTime? // kartla ödənişin təsdiq olunduğu an
  confirmDeadline     DateTime? // satıcının təsdiq etməli olduğu son vaxt (keçsə avtomatik refund)
  // Satıcı təsdiqlədikdən sonra malın yola düşməli olduğu son vaxt.
  // Kuryer tapılmasa, satıcı göndərməsə və ya sistemdə problem olsa sifariş
  // burada ilişib qalırdı: alıcının pulu çəkilmiş, mal yoxdur, heç nə hərəkət
  // etmir. Bu tarix keçəndə sifariş avtomatik ləğv olunur və pul qaytarılır.
  deliveryDeadline    DateTime?
  // HİSSƏLİ ALIŞ (taksit) — alıcının seçdiyi ay sayı (3/6/9/12/18).
  //
  // DİQQƏT: ödəniş şlüzü (YIĞIM/MAGNET v1.16) məbləği HİSSƏLƏRƏ BÖLMÜR — API-də
  // belə parametr yoxdur. Taksit alıcının öz taksit kartı (BirKart, Tamkart və s.)
  // ilə tətbiq olunur: biz tam məbləği alırıq, bank onu kart sahibi üçün bölür.
  // Bu sahə alıcının seçimini qeyd edir ki, satıcı və admin nə razılaşdığını
  // görsün; pulun bizə gəlişi dəyişmir.
  installmentMonths   Int?
  // Alıcı bu ödənişdə "kartı yadda saxla" seçibmi. Ödəniş uğurlu olanda
  // şlüzün qaytardığı token saxlanılır — ayrıca kart bağlama axını yoxdur,
  // kart REAL ALIŞ zamanı saxlanılır.
  saveCardRequested   Boolean         @default(false)
  // Göndərilmiş, amma çatdırılmayan sifariş üçün admin bir dəfə xəbərdar edilir
  // (mal yolda ola bilər — avtomatik ləğv TƏHLÜKƏLİDİR, ona görə yalnız işarə).
  stuckFlaggedAt      DateTime?
  autoRefunded        Boolean         @default(false) // satıcı vaxtında təsdiqləmədiyi üçün avtomatik geri ödənildi
  // Canli takip icin
  latitude            Float?
  longitude           Float?
  estimatedDeliveryAt DateTime?
  courierLat          Float?
  courierLng          Float?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  buyer               User            @relation("BuyerOrders", fields: [buyerId], references: [id], onDelete: Cascade)
  seller              User            @relation("SellerOrders", fields: [sellerId], references: [id], onDelete: Cascade)
  courier             User?           @relation("CourierOrders", fields: [courierId], references: [id], onDelete: SetNull)
  referrer            User?           @relation("ReferralOrders", fields: [referrerId], references: [id], onDelete: SetNull)
  buyerObject         BusinessObject? @relation("ObjectPurchases", fields: [buyerObjectId], references: [id], onDelete: SetNull)
  promoCode           PromoCode?      @relation(fields: [promoCodeId], references: [id], onDelete: SetNull)
  items               OrderItem[]
  returnRequests      ReturnRequest[]
  refundAttempt       RefundAttempt?
  sellerRating        SellerRating?

  @@index([buyerId, createdAt])
  @@index([sellerId, createdAt])
  @@index([status])
  @@index([gatewayOrderId])
  @@index([gatewayRef])
}

model EmailVerification {
  id        Int      @id @default(autoincrement())
  userId    Int
  email     String
  code      String
  expiresAt DateTime
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// İstifadəçinin sosial media hesabları — admin tərəfindən təsdiqlənir,
// təsdiqlənənlər public profildə "✓" ilə göstərilir.
model SocialLink {
  id        Int      @id @default(autoincrement())
  userId    Int
  platform  String // instagram, facebook, tiktok, youtube, linkedin, twitter, telegram, website
  url       String
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, platform])
}

// Peşə sənədləri (diplom, sertifikat, lisenziya). AI ad-soyad uyğunluğunu yoxlayır.
model ProfessionDocument {
  id              Int                @id @default(autoincrement())
  userId          Int
  title           String // istifadəçinin verdiyi başlıq (məs. "Diplom", "Həkimlik lisenziyası")
  image           String // uploads/ faylının adı
  documentType    String? // AI: diplom / sertifikat / lisenziya
  issuer          String? // AI: kim verib
  holderName      String? // AI: sənəddəki ad-soyad
  nameMatch       Boolean            @default(false) // ad-soyad istifadəçi ilə uyğundur?
  nameMatchScore  Float? // 0..1
  professionMatch Boolean? // məsləklə uyğundur?
  confidence      Float? // 0..1
  fraudSignals    String[]           @default([])
  aiReason        String? // AI-ın qısa izahı
  isPublic        Boolean            @default(false) // public profildə görünsünmü (YES ikonu)
  status          VerificationStatus @default(PENDING) // PENDING / APPROVED / REJECTED (admin son sözü)
  createdAt       DateTime           @default(now())
  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

model OrderItem {
  id             Int             @id @default(autoincrement())
  orderId        Int
  listingId      Int
  quantity       Int
  price          Float
  title          String
  order          Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  listing        Listing         @relation(fields: [listingId], references: [id], onDelete: Cascade)
  returnRequests ReturnRequest[]
}

model ReturnRequest {
  id           Int          @id @default(autoincrement())
  orderId      Int
  orderItemId  Int?
  buyerId      Int
  sellerId     Int
  status       ReturnStatus @default(REQUESTED)
  reason       ReturnReason
  reasonText   String?
  quantity     Int
  refundAmount Float?
  sellerNote   String?
  adminNote    String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  order        Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderItem    OrderItem?   @relation(fields: [orderItemId], references: [id], onDelete: SetNull)
  buyer        User         @relation("BuyerReturns", fields: [buyerId], references: [id], onDelete: Cascade)
  seller       User         @relation("SellerReturns", fields: [sellerId], references: [id], onDelete: Cascade)
}

enum InquiryStatus {
  OPEN
  CLOSED
  ACCEPTED
  EXPIRED
}

enum OfferStatus {
  PENDING
  ACCEPTED
  REJECTED
  WITHDRAWN
}

model Inquiry {
  id            Int             @id @default(autoincrement())
  buyerId       Int
  rawText       String
  aiAnalysis    Json?
  cities        String[]        @default([])
  status        InquiryStatus   @default(OPEN)
  expiresAt     DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  buyer         User            @relation("BuyerInquiries", fields: [buyerId], references: [id], onDelete: Cascade)
  offers        InquiryOffer[]
  targetSellers InquiryTarget[]
}

model InquiryTarget {
  id        Int      @id @default(autoincrement())
  inquiryId Int
  sellerId  Int
  seen      Boolean  @default(false)
  createdAt DateTime @default(now())
  inquiry   Inquiry  @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  seller    User     @relation("TargetedInquiries", fields: [sellerId], references: [id], onDelete: Cascade)

  @@unique([inquiryId, sellerId])
}

model InquiryOffer {
  id        Int         @id @default(autoincrement())
  inquiryId Int
  sellerId  Int
  listingId Int?
  price     Float
  message   String?
  status    OfferStatus @default(PENDING)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  inquiry   Inquiry     @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  seller    User        @relation("SellerOffers", fields: [sellerId], references: [id], onDelete: Cascade)
  listing   Listing?    @relation(fields: [listingId], references: [id], onDelete: SetNull)
}

// ==================== BOLT FOOD BENZERI MODELLER ====================

model Favorite {
  id        Int      @id @default(autoincrement())
  userId    Int
  listingId Int
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([userId, listingId])
}

model SavedAddress {
  id        Int      @id @default(autoincrement())
  userId    Int
  label     String // "Ev", "Is", "Anne evi"
  address   String
  phone     String?
  latitude  Float?
  longitude Float?
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PromoCode {
  id             Int       @id @default(autoincrement())
  code           String    @unique
  description    String?
  discountType   String // "PERCENT" veya "FIXED"
  discountValue  Float
  minOrderAmount Float?
  maxDiscount    Float?
  usageLimit     Int?
  usageCount     Int       @default(0)
  validFrom      DateTime  @default(now())
  validUntil     DateTime?
  active         Boolean   @default(true)
  createdAt      DateTime  @default(now())
  orders         Order[]
}

model SellerRating {
  id        Int      @id @default(autoincrement())
  orderId   Int      @unique
  sellerId  Int
  buyerId   Int
  rating    Int // 1-5
  comment   String?
  createdAt DateTime @default(now())
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  seller    User     @relation("SellerRatings", fields: [sellerId], references: [id], onDelete: Cascade)
  buyer     User     @relation("BuyerRatings", fields: [buyerId], references: [id], onDelete: Cascade)

  @@index([sellerId])
}

model SellerVerification {
  id              Int                @id @default(autoincrement())
  userId          Int                @unique
  idImageFront    String
  idImageBack     String?
  taxId           String
  iban            String?
  businessName    String?
  status          VerificationStatus @default(PENDING)
  rejectionReason String?
  submittedAt     DateTime           @default(now())
  reviewedAt      DateTime?
  reviewedBy      Int?
  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  type      String // "ORDER", "MESSAGE", "INQUIRY", "PROMO", "SYSTEM"
  title     String
  body      String
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@index([userId, createdAt])
}

// ==================== BİZNES HESABI ====================
// Bir istifadəçi çoxlu biznes əlavə edə bilər. Biznes admin tərəfindən
// təsdiqlənəndə həmin biznesə bağlı elanlar KART ödənişi qəbul edir
// (VÖEN + bank hesabı olmadan bank pul köçürə bilmir).

enum BusinessKind {
  LEGAL // Hüquqi şəxs
  PHYSICAL // Fiziki şəxs
}

enum BusinessProofType {
  TAX_DOC // Vergi qeydiyyatını təsdiq edən sənəd
  POWER_OF_ATTORNEY // Etibarnamə (+ şirkət sənədi)
}

model Business {
  id                 Int                @id @default(autoincrement())
  userId             Int
  kind               BusinessKind       @default(PHYSICAL)
  proofType          BusinessProofType  @default(TAX_DOC)
  name               String
  voen               String
  ownerName          String
  founderName        String
  phone              String? // şirkət telefonu
  // Opsional əlaqə/onlayn — biznes əlavə edilərkən istəyə bağlı
  website            String? // biznesin veb-saytı
  instagram          String?
  facebook           String?
  tiktok             String?
  youtube            String?
  linkedin           String?
  status             VerificationStatus @default(PENDING)
  // Müqavilədəki "Ünvan" xanası — hüquqi (qeydiyyat) ünvanı. Obyektin
  // ünvanı ilə eyni olmaya bilər, ona görə ayrıca saxlanılır.
  legalAddress       String?
  // ── SATICI MÜQAVİLƏSİ (DocuSign) ──
  // NOT_SENT → SENT (imzaya göndərilib) → SIGNED (hər iki tərəf imzaladı)
  //          → DECLINED / VOIDED
  contractStatus     String             @default("NOT_SENT")
  contractEnvelopeId String? // DocuSign zərf id-si
  contractSentAt     DateTime?
  contractSignedAt   DateTime?
  contractPdf        String? // imzalanmış PDF-in fayl adı
  contractVersion    Int? // hansı şablon versiyası imzalanıb
  isActive           Boolean            @default(true) // sahibi tərəfindən aktiv/deaktiv
  deletedAt          DateTime? // admin sildi — sətir maliyyə tarixçəsi üçün qalır
  rejectionReason    String?
  createdAt          DateTime           @default(now())
  reviewedAt         DateTime?

  // KYC sənədləri (fayl adları)
  taxDocImage          String? // vergi qeydiyyatı sənədi (TAX_DOC)
  companyDocImage      String? // şirkət sənədi (POWER_OF_ATTORNEY halında)
  powerOfAttorneyImage String? // etibarnamə
  bankDocImage         String? // (köhnə) tək bank sənədi
  bankDocImages        String[] @default([]) // bir neçə bank hesabı sənədi (IBAN-lar AI ilə oxunur)
  idCardImage          String? // şəxsiyyət vəsiqəsi
  selfieImage          String? // üz tanıma üçün selfie (admin əllə yoxlayır)

  // Claude AI sənəd yoxlaması (avtomatik təsdiq üçün)
  aiAuthorized   Boolean? // profil sahibi rəhbər/etibarnaməli olaraq təsdiqləndi?
  aiVoenMatch    Boolean? // sənədlərdəki VÖEN forma ilə uyğun?
  aiConfidence   Float? // 0..1
  aiFraudSignals String[] @default([])
  aiReason       String? // AI-ın qısa izahı
  autoApproved   Boolean  @default(false) // AI tərəfindən avtomatik təsdiqləndi?

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  objects  BusinessObject[]
  listings Listing[]
  banks    BankAccount[]
  members  BusinessMember[]

  @@index([userId])
  @@index([status])
}

model BankAccount {
  id         Int      @id @default(autoincrement())
  businessId Int
  iban       String // bank hesabı / IBAN
  title      String? // bank adı / qeyd
  isActive   Boolean  @default(true)
  isPrimary  Boolean  @default(false) // ödəniş bu hesab üzərindən gedir ("yes" seçilən)
  docImage   String? // bu hesabın aid olduğu bank sənədi (fayl adı)
  createdAt  DateTime @default(now())
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
}

model BusinessObject {
  id              Int              @id @default(autoincrement())
  businessId      Int
  name            String // obyekt adı (məs. "Aptek №3")
  phone           String? // obyekt telefonu
  activityAreas   String[]         @default([]) // fəaliyyət sahələri (16 kateqoriya adları)
  isActive        Boolean          @default(true) // aktiv/passiv
  deletedAt       DateTime? // admin sildi — sətir tarixçə üçün qalır
  address         String
  city            String?
  latitude        Float?
  longitude       Float?
  createdAt       DateTime         @default(now())
  referralEnabled Boolean          @default(false) // referal (komissiyalı) satışa icazə
  business        Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  listings        Listing[]
  messages        Message[]
  managers        BusinessMember[]
  referralRules   ReferralRule[]
  purchases       Order[]          @relation("ObjectPurchases") // bu obyekt adına edilən alışlar
  comments        Comment[] // obyekt haqqında rəylər

  @@index([businessId])
}

// Referal qaydası: mağaza (obyekt) hansı ixtisasa hansı faizlə komissiya verir + sənəd tələbi.
model ReferralRule {
  id                Int            @id @default(autoincrement())
  objectId          Int
  profession        String // İxtisas adı (məs. "Həkim")
  commissionPercent Float // komissiya faizi (0..100)
  requiredDoc       String         @default("NONE") // NONE | DIPLOMA | CV | ANY
  object            BusinessObject @relation(fields: [objectId], references: [id], onDelete: Cascade)

  @@index([objectId])
}

// Peşəkarın yaratdığı referal səbət (link) — alıcıya göndərilir.
model ReferralCart {
  id         Int      @id @default(autoincrement())
  token      String   @unique
  referrerId Int
  objectId   Int
  businessId Int
  percent    Float // bu referala tətbiq olunan komissiya faizi
  items      Json // [{listingId, quantity}]
  createdAt  DateTime @default(now())
  referrer   User     @relation("ReferralCarts", fields: [referrerId], references: [id], onDelete: Cascade)

  @@index([referrerId])
}

// Səlahiyyət vermə — sahibi başqa istifadəçiyə bütün biznesin və ya
// konkret obyektin idarəsini verə bilər (objectId null = bütün biznes).
// İşçilik statusu — iki tərəfli sorğu/qəbul axını.
enum MemberStatus {
  PENDING_BUSINESS // istifadəçi "mən sizin işçinizəm" sorğusu göndərib — biznes sahibi təsdiqləməlidir
  PENDING_USER // biznes dəvət göndərib — istifadəçi təsdiqləməlidir
  ACTIVE // rəsmi işçi
}

model BusinessMember {
  id         Int             @id @default(autoincrement())
  businessId Int
  userId     Int
  objectId   Int?
  status     MemberStatus    @default(ACTIVE) // köhnə sətirlər aktiv qalır
  // Sahibin işçiyə verdiyi səlahiyyətlər:
  canSell    Boolean         @default(true) // obyektin məhsullarını satmaq (elan + sifariş idarəsi)
  canBuy     Boolean         @default(false) // biznes adına məhsul almaq
  createdAt  DateTime        @default(now())
  business   Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user       User            @relation("BusinessMemberships", fields: [userId], references: [id], onDelete: Cascade)
  object     BusinessObject? @relation(fields: [objectId], references: [id], onDelete: Cascade)

  @@unique([businessId, userId, objectId])
  @@index([userId])
  @@index([businessId, status])
}

// ── Rəy (peşəkar konsultasiyası) ──────────────────────────────────────────────
enum ConsultationStatus {
  REQUESTED // alıcı sorğu göndərib, peşəkarın QƏBULU gözlənilir
  ACCEPTED // peşəkar qəbul etdi, alıcının ÖDƏNİŞİ gözlənilir
  REJECTED // peşəkar rədd etdi
  PENDING_VOEN // peşəkarın VÖEN-i yoxdur → aktivləşə bilmir
  PAID // ödənilib, peşəkar başlatmağı gözləyir
  ACTIVE // sayğac işləyir
  PAUSED // peşəkar dayandırıb
  ENDED // vaxt bitib və ya bağlanıb
}

// Peşəkarın "Rəy" təklifi — müddət + qiymət (profilə bağlı, məhsul elanı deyil).
model ConsultationOffer {
  id                   Int                   @id @default(autoincrement())
  userId               Int
  title                String?
  description          String? // peşəkarın konsultasiya haqqında qeydi/təsviri
  durationMinutes      Int                   @default(30)
  price                Float
  active               Boolean               @default(true)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  user                 User                  @relation("UserConsultationOffer", fields: [userId], references: [id], onDelete: Cascade)
  consultationSessions ConsultationSession[]

  @@index([userId])
}

// Bir konsultasiya seansı — sayğac (start/pause) və ödəniş vəziyyəti.
model ConsultationSession {
  id              Int                @id @default(autoincrement())
  buyerId         Int
  professionalId  Int
  offerId         Int?
  title           String?
  price           Float
  blockSeconds    Int                @default(0) // bir ödənişin verdiyi vaxt (reaktivasiya/top-up üçün)
  durationSeconds Int // ümumi alınan vaxt (saniyə) — top-up ilə artır
  consumedSeconds Int                @default(0)
  runningSince    DateTime? // ACTIVE olduqda dolu; pauza/bitmədə null
  status          ConsultationStatus @default(REQUESTED)
  paymentStatus   String             @default("UNPAID") // UNPAID/PAID
  gatewayProvider String?
  gatewayRef      String?
  gatewayOrderId  Int?
  gatewayPassword String?
  settledRefs     String[]           @default([]) // top-up idempotentliyi: tətbiq olunmuş ödəniş referansları
  rated           Boolean            @default(false)
  complaints      Complaint[]
  ratingStars     Int?
  ratingLike      Boolean?
  ratingText      String?
  createdAt       DateTime           @default(now())
  startedAt       DateTime?
  endedAt         DateTime?
  buyer           User               @relation("ConsultationBuyer", fields: [buyerId], references: [id], onDelete: Cascade)
  professional    User               @relation("ConsultationProfessional", fields: [professionalId], references: [id], onDelete: Cascade)
  offer           ConsultationOffer? @relation(fields: [offerId], references: [id], onDelete: SetNull)
  messages        Message[]

  @@index([buyerId])
  @@index([professionalId])
}

// ── Şikayət (profil / Rəy konsultasiyası) ─────────────────────────────────────
enum ComplaintStatus {
  OPEN
  REVIEWING
  EVIDENCE_REQUESTED
  RESOLVED
  REJECTED
}

model Complaint {
  id             Int                  @id @default(autoincrement())
  complainantId  Int
  targetUserId   Int
  consultationId Int? // dolu olarsa konkret seansa bağlıdır
  listingId      Int? // dolu olarsa məhsul/elan şikayəti (eBay üslubu — foto sübutlu)
  orderId        Int? // dolu olarsa konkret alış-sifariş şikayəti
  category       String // TIME_WASTED / FRAUD / RUDE / FAKE_INFO / DEFECTIVE / DAMAGED / NOT_AS_DESCRIBED / WRONG_ITEM / OTHER
  description    String
  images         String[]             @default([]) // sübut şəkilləri (qüsurlu məhsul və s.)
  status         ComplaintStatus      @default(OPEN)
  resolution     String? // REFUNDED / WARNED / SUSPENDED / NO_ACTION / REJECTED
  adminNote      String?
  resolvedById   Int?
  createdAt      DateTime             @default(now())
  resolvedAt     DateTime?
  complainant    User                 @relation("ComplaintsMade", fields: [complainantId], references: [id], onDelete: Cascade)
  target         User                 @relation("ComplaintsAgainst", fields: [targetUserId], references: [id], onDelete: Cascade)
  consultation   ConsultationSession? @relation(fields: [consultationId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([targetUserId])
  @@index([consultationId])
}

// Bron / rezervasiya — qonaq elanı (restoran/otel/məkan) bron edir, sahib təsdiqləyir.
model Booking {
  id           Int           @id @default(autoincrement())
  listingId    Int
  guestId      Int // bron edən
  hostId       Int // elan sahibi
  type         BookingType
  date         DateTime? // REZERVASİYA: gün
  time         String? // REZERVASİYA: saat "19:30"
  checkIn      DateTime? // GECƏLƏMƏ: giriş
  checkOut     DateTime? // GECƏLƏMƏ: çıxış
  nights       Int? // GECƏLƏMƏ: gecə sayı
  guests       Int           @default(1) // qonaq / nəfər sayı
  rooms        Int? // GECƏLƏMƏ: otaq sayı
  totalPrice   Float? // təxmini cəm (məlumat üçün)
  note         String?
  contactName  String?
  contactPhone String
  status       BookingStatus @default(PENDING)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  listing      Listing       @relation(fields: [listingId], references: [id], onDelete: Cascade)
  guest        User          @relation("GuestBookings", fields: [guestId], references: [id], onDelete: Cascade)
  host         User          @relation("HostBookings", fields: [hostId], references: [id], onDelete: Cascade)

  @@index([guestId, createdAt])
  @@index([hostId, createdAt])
  @@index([listingId])
  @@index([status])
}

// Şəxsi kontakt kitabçası — istifadəçi istədiyi nömrəni əlavə edir
// (gələcəkdə telefon kontaktlarından sinxron olunacaq — bulk endpoint hazırdır).
// Nömrə platformada qeydiyyatlıdırsa, siyahıda profil linki göstərilir.
model Contact {
  id          Int      @id @default(autoincrement())
  ownerId     Int
  name        String
  phone       String // istifadəçinin yazdığı format
  phoneDigits String // yalnız rəqəmlər — qeydiyyatlı istifadəçi ilə uyğunlaşdırma üçün
  createdAt   DateTime @default(now())
  owner       User     @relation("OwnContacts", fields: [ownerId], references: [id], onDelete: Cascade)

  @@unique([ownerId, phoneDigits])
  @@index([ownerId])
}

// İstifadəçi blokları — blocker blocked-ı bloklayıb (mesaj göndərə bilməz).
model BlockedUser {
  id        Int      @id @default(autoincrement())
  blockerId Int
  blockedId Int
  createdAt DateTime @default(now())
  blocker   User     @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User     @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockedId])
}

// Bağlı cihazlar — profilə daxil olan hər cihaz/sessiya (WhatsApp "linked devices" məntiqi).
// JWT-nin içindəki `sid` bu sətrə işarə edir; revokedAt qoyulanda həmin cihaz sistemdən atılır.
model Session {
  id         String    @id @default(cuid())
  userId     Int
  os         String? // əməliyyat sistemi (Windows, macOS, iOS, Android...)
  browser    String? // brauzer (Firefox, Safari, Chrome...)
  deviceType String? // Desktop | Mobile | Tablet
  userAgent  String? // tam User-Agent (diaqnostika üçün)
  ip         String? // son IP (təxmini)
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  revokedAt  DateTime? // uzaqdan bağlanma vaxtı
  user       User      @relation("UserSessions", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Ana səhifə karuseli — admin şəkil/banner yükləyir (endirimlər və s.).
model Banner {
  id        Int      @id @default(autoincrement())
  image     String // yüklənmiş fayl adı
  position  String   @default("MAIN") // MAIN = əsas karusel, SIDE = sağ yan bannerlər
  link      String? // klikləyəndə keçid (opsional)
  title     String? // alt yazı / başlıq (opsional)
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([active, sortOrder])
}

// Admin idarə edilən tənzimləmələr (feature-flags) — açar/dəyər. Dəyər mətn kimi
// saxlanılır (boolean üçün "true"/"false"). Admin paneldə aktiv/deaktiv edilir.
// ── Biznes yaratma haqqı ──────────────────────────────────────────────────────
// Biznes yaratmaq birdəfəlik ödənişlidir (məbləğ: `business_fee_azn` setting-i,
// admin paneldən dəyişilir; 0 = pulsuz). İstifadəçi ödəyir → PAID qeydi yaranır
// → biznes forması göndəriləndə həmin qeyd USED olur.
//
// Niyə ayrı model: bu ödəniş Order deyil (məhsul yoxdur, çatdırılma yoxdur,
// komissiya yoxdur). Order cədvəlinə saxta sifariş yazmaq bütün maliyyə
// hesabatlarını korlayardı.
model BusinessFee {
  id     Int    @id @default(autoincrement())
  userId Int
  amount Float // ödəniş anındakı tarif (sonradan tarif dəyişsə də bu qalır)

  // UNPAID → PAID (ödənildi, hələ istifadə olunmayıb) → USED (biznes yaradıldı)
  // FAILED — şlüz ödənişi rədd etdi. REFUNDED — pul geri qaytarıldı.
  status String @default("UNPAID")

  gatewayProvider String?
  gatewayRef      String? @unique // YIĞIM referansı — callback bununla tapır
  gatewayOrderId  Int? // Kapital order id
  gatewayPassword String?

  businessId Int? // hansı biznes üçün xərclənib (rədd olunsa geri açılır)
  paidAt     DateTime?
  usedAt     DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([gatewayOrderId])
}

model Setting {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ── Admin audit jurnalı — hər admin əməliyyatı (kim, nə, nə vaxt) ──────────────
model AdminAuditLog {
  id         Int      @id @default(autoincrement())
  adminId    Int
  adminName  String // anlıq surət (admin sonradan silinsə/adı dəyişsə də qalır)
  method     String // POST/PUT/PATCH/DELETE
  path       String // /api/admin/...
  action     String // törədilmiş etiket, məs. "listing.status"
  targetType String? // listing/user/order/...
  targetId   String?
  status     Int // HTTP status kodu
  summary    String // oxunaqlı izah
  meta       Json? // əlavə (redaktə olunmuş body və s.)
  ip         String?
  createdAt  DateTime @default(now())

  @@index([adminId, createdAt])
  @@index([action])
  @@index([targetType, targetId])
  @@index([createdAt])
}

// ── Satıcı hesablaşması (ledger) — hər ödənilmiş sifariş üçün qazanc qeydi ─────
enum LedgerStatus {
  PENDING // ödənilib, amma hələ çatdırılmayıb (buyer protection pəncərəsi)
  AVAILABLE // çatdırılıb — satıcıya ödənilə bilər
  PAID_OUT // satıcıya ödənilib
  REVERSED // qaytarma/ləğv — geri alınıb
}

model SellerLedger {
  id             Int          @id @default(autoincrement())
  sellerId       Int
  orderId        Int          @unique
  buyerId        Int
  grossAmount    Float // sifarişin ümumi məbləği
  commissionRate Float // tətbiq olunan komissiya faizi (surət)
  commission     Float // platforma komissiyası
  netAmount      Float // satıcının qazancı (gross - commission)
  heldByPlatform Boolean      @default(true) // KART: platforma pulu saxlayır. NAĞD: satıcı özü alıb (komissiya borcu)
  status         LedgerStatus @default(PENDING)
  // Hansı BİZNESƏ aiddir — ödəniş biznesin bank hesabına (BankAccount.isPrimary)
  // köçürüldüyü üçün hesablaşma biznes üzrə qruplaşdırılır. null → şəxsi satıcı.
  // Köhnə sətirlər üçün admin paneli ilk oxunuşda doldurur (lazy backfill).
  businessId     Int?
  // ALICI MÜDAFİƏSİ: çatdırılandan sonra pul DƏRHAL ödənilə bilməz — qaytarma
  // pəncərəsi bitməlidir. Bu tarixdən əvvəl sətir PENDING qalır və ödəniş
  // ekranında görünmür. `payout_hold_days` ayarı ilə idarə olunur.
  availableAt    DateTime?
  // Pul artıq satıcıya köçürüldükdən SONRA sifariş ləğv/qaytarma olubsa —
  // bu pulu satıcıdan geri almaq lazımdır. Avtomatik geri alına bilmədiyi üçün
  // admin üçün işarələnir (əks halda zərər bizim üzərimizdə qalır).
  clawbackNeeded Boolean      @default(false)
  clawbackReason String?
  payoutId       Int?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([sellerId, status])
  @@index([businessId, status])
  @@index([payoutId])
  @@index([clawbackNeeded])
}

// ── Payout — satıcıya edilmiş ödəniş (bir neçə ledger-i əhatə edir) ────────────
model Payout {
  id             Int       @id @default(autoincrement())
  sellerId       Int
  // Ödəniş hansı biznesin bank hesabına getdi (varsa).
  businessId     Int?
  iban           String? // köçürmə anındakı IBAN — sonradan dəyişsə tarixçə pozulmasın
  amount         Float
  method         String? // bank köçürməsi / nağd / digər
  reference      String? // köçürmə referansı / admin qeydi
  createdById    Int // əməliyyatı edən admin
  createdName    String
  createdAt      DateTime  @default(now())
  // Səhvən edilmiş ödəniş geri alına bilər — sətirlər yenidən ödəniləcək olur.
  reversedAt     DateTime?
  reversedById   Int?
  reversedName   String?
  reversedReason String?

  @@index([sellerId, createdAt])
  @@index([businessId, createdAt])
}

// ── CMS səhifələri — admin paneldən redaktə olunan statik məzmun (about/terms/faq) ──
model Page {
  id          Int      @id @default(autoincrement())
  slug        String   @unique
  title       String
  content     String // HTML / markdown mətn
  published   Boolean  @default(true)
  updatedById Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ── Dəstək ticket sistemi ────────────────────────────────────────────────────
enum TicketStatus {
  OPEN // istifadəçi açdı, admin cavabı gözlənir
  PENDING // admin cavab verdi, istifadəçidən gözlənir
  RESOLVED // həll olundu
  CLOSED // bağlandı
}

model SupportTicket {
  id          Int             @id @default(autoincrement())
  userId      Int
  subject     String
  category    String          @default("OTHER") // ORDER/PAYMENT/ACCOUNT/LISTING/OTHER
  status      TicketStatus    @default(OPEN)
  lastReplyAt DateTime        @default(now())
  createdAt   DateTime        @default(now())
  messages    TicketMessage[]

  @@index([userId, createdAt])
  @@index([status, lastReplyAt])
}

model TicketMessage {
  id         Int           @id @default(autoincrement())
  ticketId   Int
  senderId   Int
  isAdmin    Boolean       @default(false)
  senderName String
  body       String
  images     String[]      @default([])
  createdAt  DateTime      @default(now())
  ticket     SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
}

// ── Sosial media müraciəti (outreach) ─────────────────────────────────────────
// İstifadəçi websearch-də tapdığı şəxsə mesaj yazır; mesaj ADMİN PANELƏ düşür,
// admin həmin sosial media hesabına ƏLLƏ göndərir və nəticəni qeyd edir.
enum OutreachStatus {
  PENDING // admin göndərməyi gözləyir
  SENT // admin göndərdi
  REJECTED // admin rədd etdi (uyğunsuz/spam)
}

model SocialOutreach {
  id             Int            @id @default(autoincrement())
  requesterId    Int
  // Hədəf profil (websearch nəticəsindən)
  targetName     String // ekranda görünən ad
  targetPlatform String // instagram / facebook / linkedin / tiktok / x / youtube / telegram
  targetHandle   String // istifadəçi adı
  targetUrl      String // profilin tam linki
  targetAvatar   String? // profil şəkli (varsa)
  // Saytda qeydiyyatlı istifadəçiyə aiddirsə — birbaşa chat mümkündür
  matchedUserId  Int?
  message        String // istifadəçinin yazdığı mətn
  status         OutreachStatus @default(PENDING)
  adminNote      String?
  sentById       Int?
  sentByName     String?
  sentAt         DateTime?
  createdAt      DateTime       @default(now())
  requester      User           @relation("OutreachRequests", fields: [requesterId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([requesterId, createdAt])
}

// PULUN GERİ QAYTARILMASI — hər cəhdin qeydi.
//
// Niyə ayrıca cədvəl: şlüzə edilən qaytarma sorğusu uğursuz ola bilər (şəbəkə,
// şlüz sınıb, token bitib). Əvvəl bu hal yalnız konsola yazılırdı — sifariş
// ləğv olunmuş görünür, `paymentStatus` isə PAID qalırdı: alıcının pulu geri
// qayıtmır, heç kim də bilmirdi. İndi hər cəhd sətir kimi qalır, uğursuzlar
// avtomatik təkrarlanır və admin panelində "qaytarılmalı pul" siyahısına düşür.
//
// orderId UNİKALDIR — eyni sifariş üçün iki qaytarma sətri yaranmır. Bu, həm
// audit, həm də İKİQAT QAYTARMA qıfılıdır (iki ləğv sorğusu eyni anda gəlsə
// yalnız biri şlüzə çatır).
model RefundAttempt {
  id        Int       @id @default(autoincrement())
  orderId   Int       @unique
  amount    Float
  reason    String // CANCELLED | TIMEOUT | RETURN | ADMIN
  status    String    @default("PENDING") // PENDING | DONE | FAILED
  attempts  Int       @default(0)
  lastError String?
  provider  String?
  adminNote String? // admin əl ilə həll edibsə (məs. bankdan köçürüldü)
  doneAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  order     Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([status])
}

// SAXLANMIŞ KART (YIĞIM tokenizasiyası).
//
// Kartın ÖZÜ bizdə saxlanmır — nə nömrə, nə CVV. YIĞIM kartı öz tərəfində
// saxlayır və bizə `token` verir; biz yalnız tokeni, maskalanmış nömrəni və
// bitmə tarixini yazırıq. PCI DSS yükü şlüzdə qalır.
//
// TƏHLÜKƏSİZLİK: `token` faktiki olaraq kartın açarıdır — onunla bizim
// merchant üzərindən pul çəkmək olar. Ona görə BRAUZERƏ HEÇ VAXT
// GÖNDƏRİLMİR: müştəri yalnız `id`-ni görür, ödəniş serverdə həmin id ilə
// icra olunur.
model SavedCard {
  id         Int       @id @default(autoincrement())
  userId     Int
  // Kartın saxlandığı ödənişin referansı (audit üçün).
  reference  String?   @unique
  status     String    @default("ACTIVE")
  token      String? // YIĞIM kart tokeni — serverdən çıxmır
  maskedPan  String? // 510068******0966
  expiry     String? // mmyy
  brand      String? // Visa / MasterCard
  issuer     String? // kartı verən bank
  isDefault  Boolean   @default(false)
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, token])
  @@index([userId, status])
}

// ── HÜQUQİ SƏNƏDLƏR VƏ QƏBUL QEYDİ ────────────────────────────────────────
//
// Sənədin MƏTNİ bazada saxlanılır ki, admin dəyişə bilsin; hər dəyişiklik yeni
// VERSİYA yaradır. Versiya vacibdir: İstifadəçi Razılaşmasının 13-cü bəndi
// dəyişikliyə icazə verir, mübahisədə isə "hansı mətni qəbul etmişdi?" sualına
// cavab lazımdır.
model LegalDocument {
  id                  Int           @id @default(autoincrement())
  slug                String // user-agreement | commission-rules | return-rules | seller-agreement | privacy
  version             Int           @default(1)
  title               String
  body                String // sənədin tam mətni (olduğu kimi — dəyişdirilmir)
  // Bu sənəd qəbul edilmədən alış mümkün olmasınmı.
  requiredForPurchase Boolean       @default(false)
  isActive            Boolean       @default(true) // qüvvədə olan versiya
  publishedAt         DateTime      @default(now())
  consents            UserConsent[]

  @@unique([slug, version])
  @@index([slug, isActive])
}

// Kim, hansı sənədin hansı versiyasını, nə vaxt, haradan qəbul edib.
// IP və brauzer imzası mübahisədə sübut kimi saxlanılır.
model UserConsent {
  id         Int           @id @default(autoincrement())
  userId     Int
  documentId Int
  slug       String // sürətli sorğu üçün surət
  version    Int
  ip         String?
  userAgent  String?
  acceptedAt DateTime      @default(now())
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  document   LegalDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([userId, documentId])
  @@index([userId, slug])
}
