generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserType {
  CAR_OWNER
  MECHANIC
  PARTS_SELLER
  COURIER
}

enum UserRole {
  USER
  ADMIN
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ListingType {
  PRODUCT
  SERVICE
}

enum BookingType {
  RESERVATION // restoran/masa/məkan — tarix + saat + nəfər
  STAY // otel/bağ evi/günlük kirayə — giriş-çıxış tarixi
}

enum BookingStatus {
  PENDING // sahibin təsdiqini gözləyir
  CONFIRMED // sahib təsdiqlədi
  REJECTED // sahib rədd etdi
  CANCELLED // qonaq ləğv etdi
  COMPLETED // baş tutdu / keçmişdə qaldı
}

enum Condition {
  NEW
  USED
  REFURBISHED
}

enum FuelType {
  GASOLINE
  DIESEL
  HYBRID
  ELECTRIC
  GAS
  OTHER
}

enum PaymentType {
  CASH
  CREDIT
  BOTH
}

enum OrderStatus {
  PENDING
  CONFIRMED
  SHIPPED
  DELIVERED
  CANCELLED
}

enum DeliveryType {
  DELIVERY
  PICKUP
}

// Çatdırılma kim tərəfindən olunur (satıcı seçir, VÖEN elanlarda):
// COURIER = kuryer (Yango) ilə; SELF = satıcı özü çatdırır.
enum DeliveryMethod {
  COURIER
  SELF
}

enum PaymentMethod {
  CASH
  CARD
  WALLET
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum ReturnStatus {
  REQUESTED
  APPROVED
  REJECTED
  RETURN_SHIPPED
  RETURN_RECEIVED
  REFUNDED
  CANCELLED
}

enum ReturnReason {
  DEFECTIVE
  WRONG_ITEM
  NOT_AS_DESCRIBED
  CHANGED_MIND
  OTHER
}

model User {
  id                    Int                   @id @default(autoincrement())
  name                  String                @default("")
  phone                 String
  email                 String?
  emailVerified         Boolean               @default(false) // email doğrulama kodu ilə təsdiqlənib
  telegramId            String?               @unique
  type                  UserType              @default(CAR_OWNER)
  role                  UserRole              @default(USER)
  password              String?
  verified              Boolean               @default(false)
  isBlocked             Boolean               @default(false) // admin tərəfindən bloklanıb
  profileComplete       Boolean               @default(false)
  profession            String? // ixtisas (qeydiyyatda soruşulur)
  bio                   String? // istifadəçinin özü haqqında qeydi
  avatar                String? // profil şəkli
  cvFile                String? // istifadəçinin CV-si (PDF/şəkil)
  cvPublic              Boolean               @default(false) // CV public profildə görünsünmü
  idNumber              String? // kimlik / FIN (köhnə — indi şəkil istənir)
  birthDate             DateTime? // doğum tarixi (vəsiqədən AI ilə)
  gender                String? // cinsiyyət (vəsiqədən AI ilə: "Kişi"/"Qadın")
  idCardImage           String? // şəxsiyyət vəsiqəsi ön tərəf
  idCardBackImage       String? // şəxsiyyət vəsiqəsi arxa tərəf (yalnız sahibi görür)
  selfieImage           String? // selfie — ön (qarşıdan, üz tanıma üçün)
  selfieRightImage      String? // selfie — sağ profil
  selfieLeftImage       String? // selfie — sol profil
  faceMatchScore        Float? // face-api.js oxşarlıq balı (0–1, brauzerdə)
  // Claude AI kimlik doğrulaması (vəsiqədəki ad + üz uyğunluğu)
  idAiNameMatch         Boolean? // vəsiqədəki ad qeydiyyatla uyğun?
  idAiNameScore         Float? // 0..1
  idAiFaceMatch         Boolean? // vəsiqə fotosu ilə selfie eyni şəxs?
  idAiFaceScore         Float? // 0..1
  idAiReason            String? // AI-ın qısa izahı
  idVerifyStatus        VerificationStatus? // null=təqdim olunmayıb, PENDING=admin gözləyir
  // Veriff (peşəkar KYC) inteqrasiyası — konfiqurasiya olunanda istifadə edilir
  veriffSessionId       String? // son Veriff sessiyası
  veriffStatus          String? // Veriff-in xam statusu (approved/declined/resubmission_requested...)
  sellerVerified        Boolean               @default(false) // ≥1 təsdiqlənmiş biznesi var
  sellerVerifiedAt      DateTime?
  sellerApplication     SellerVerification?
  businesses            Business[]
  businessMemberships   BusinessMember[]      @relation("BusinessMemberships")
  consultationOffers    ConsultationOffer[]   @relation("UserConsultationOffer")
  consultationsBought   ConsultationSession[] @relation("ConsultationBuyer")
  consultationsSelling  ConsultationSession[] @relation("ConsultationProfessional")
  consultationSuspended Boolean               @default(false) // admin Rəy təkliflərini dayandırıb
  complaintFlags        Int                   @default(0) // təsdiqlənmiş şikayət sayı
  complaintsMade        Complaint[]           @relation("ComplaintsMade")
  complaintsAgainst     Complaint[]           @relation("ComplaintsAgainst")
  publicId              String?               @unique // hər kəsə verilən xüsusi ID (profildə)
  createdAt             DateTime              @default(now())
  vehicles              Vehicle[]
  workplaces            Workplace[]
  verificationCodes     VerificationCode[]
  listings              Listing[]
  sentMessages          Message[]             @relation("SentMessages")
  receivedMessages      Message[]             @relation("ReceivedMessages")
  comments              Comment[]
  cart                  Cart?
  buyerOrders           Order[]               @relation("BuyerOrders")
  sellerOrders          Order[]               @relation("SellerOrders")
  courierOrders         Order[]               @relation("CourierOrders")
  referralOrders        Order[]               @relation("ReferralOrders")
  referralCarts         ReferralCart[]        @relation("ReferralCarts")
  emailVerifications    EmailVerification[]
  socialLinks           SocialLink[]
  professionDocuments   ProfessionDocument[]
  phones                PhoneNumber[]
  sharedCarts           SharedCart[]
  buyerReturns          ReturnRequest[]       @relation("BuyerReturns")
  sellerReturns         ReturnRequest[]       @relation("SellerReturns")
  buyerInquiries        Inquiry[]             @relation("BuyerInquiries")
  targetedInquiries     InquiryTarget[]       @relation("TargetedInquiries")
  sellerOffers          InquiryOffer[]        @relation("SellerOffers")

  // Bolt Food benzeri ozellikler
  loyaltyPoints Int            @default(0)
  isPremium     Boolean        @default(false)
  premiumUntil  DateTime?
  avgRating     Float? // satici icin ortalama rating
  ratingCount   Int            @default(0)
  businessHours Json? // {monday: {open: "09:00", close: "18:00"}, ...}
  favorites     Favorite[]
  addresses     SavedAddress[]
  sellerRatings SellerRating[] @relation("SellerRatings")
  givenRatings  SellerRating[] @relation("BuyerRatings")
  guestBookings Booking[]      @relation("GuestBookings")
  hostBookings  Booking[]      @relation("HostBookings")
  contacts      Contact[]      @relation("OwnContacts")
  notifications Notification[]

  // Default location — used on listings + city-search browsing.
  city      String?
  address   String?
  latitude  Float?
  longitude Float?

  // Usta / satıcı ixtisası — hansı avtomobil markaları və hansı hissə
  // kateqoriyaları üzrə xidmət göstərir (MECHANIC / PARTS_SELLER üçün).
  serviceBrands     String[] @default([]) // seçilmiş marka adları (məs. ["BMW", "Mercedes-Benz"])
  serviceAllBrands  Boolean  @default(false) // bütün markalarla işləyir
  serviceCategories String[] @default([]) // seçilmiş hissə id-ləri (bax: sellerCategories.ts)

  @@index([phone])
  @@index([type])
  @@index([createdAt])
  @@index([city])
}

model Vehicle {
  id     Int    @id @default(autoincrement())
  userId Int
  brand  String
  model  String
  year   Int

  // Backwards-compatible legacy single-image field. New rows use the
  // front/back pair below; old rows keep this populated.
  passportImage String @default("")

  // Texniki pasport şəkilləri (ön və arxa hissələr)
  passportImageFront String? // ön kart şəkli
  passportImageBack  String? // arxa kart şəkli

  // ===== Texniki pasportun ön hissəsi =====
  registrationNumber String? // A — Qeydiyyat nişanı (məs: 77NP518)
  registrationDate   String? // B.1 — Qeydiyyat tarixi (məs: 25.11.2024)
  manufactureYear    Int? // B.2 — İstehsal tarixi (il)
  ownerName          String? // C.1 — Mülkiyyətçi (məs: ƏSƏDOV EMIN ASLAN OĞLU)
  ownerAddress       String? // C.2 — Sahibinin ünvanı
  ownershipType      String? // C.3 — Mülkiyyət növü (Fiziki şəxs / Hüquqi şəxs)
  validUntil         String? // H — Etibarlıdır
  cardSerial         String? // Kart üzərindəki seriya (məs: BB667834)

  // ===== Texniki pasportun arxa hissəsi =====
  vehicleType    String? // D.3 — Tip (məs: MİNİK, UNIVERSAL)
  engineNumber   String? // E.1 — Mühərrik nömrəsi
  bodyNumber     String? // E.2 — Ban nömrəsi (VIN)
  chassisNumber  String? // E.3 — Şassi nömrəsi
  color          String? // E.4 — Rəngi
  maxMass        String? // F.1 — Maksimal kütlə
  unloadedMass   String? // F.2 — Yüksüz kütlə
  seatCount      Int? // F.3 — Oturacaqların sayı
  engineCapacity String? // G — Mühərrikin həcmi (sm³)
  issuedBy       String? // Verilib (məs: AR DİN BDYPİ Qİİ)
  specialMarks   String? // Xüsusi qeydlər

  // AI çıxarışı və metadata
  aiExtracted  Json? // AI-nın qaytardığı xam JSON (audit / debug üçün)
  aiVerifiedAt DateTime? // AI-nın oxuduğu vaxt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([registrationNumber])
  @@index([bodyNumber])
}

model Workplace {
  id        Int    @id @default(autoincrement())
  userId    Int
  name      String
  address   String
  latitude  Float?
  longitude Float?
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationCode {
  id        Int      @id @default(autoincrement())
  userId    Int
  code      String
  expiresAt DateTime
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// İstifadəçinin telefon nömrələri — biri əsas (user.phone), digərləri məlumat üçün.
// Hər nömrə doğrulama kodu ilə təsdiqlənir.
model PhoneNumber {
  id            Int       @id @default(autoincrement())
  userId        Int
  phone         String
  isPrimary     Boolean   @default(false) // əsas nömrə → user.phone + elanlardakı nömrə
  verified      Boolean   @default(false)
  code          String? // doğrulama kodu (təsdiqdən sonra təmizlənir)
  codeExpiresAt DateTime?
  createdAt     DateTime  @default(now())
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, phone])
  @@index([userId])
}

model Listing {
  id               Int             @id @default(autoincrement())
  userId           Int
  title            String
  description      String
  price            Float
  category         String
  type             ListingType
  images           String[]
  location         String?
  phone            String?
  condition        Condition       @default(NEW)
  country          String?
  brand            String?
  stock            Int             @default(1)
  forVehicle       String?
  unit             String?
  unitValue        Float?
  year             Int?
  model            String?
  city             String?
  fuelType         FuelType?
  attributes       Json? // kateqoriyaya xüsusi sahələr (otaq sayı, sahə, ölçü, yürüş...)
  paymentType      PaymentType?
  barter           Boolean         @default(false) // dəyiş-düş (barter) qəbul olunur
  forRent          Boolean         @default(false) // satış yox, icarə/kirayə
  // Bron / rezervasiya — restoran, otel, bağ evi, məkan və s. bron edilə bilər
  bookable         Boolean         @default(false)
  // Satıcı VÖEN elanda "məhsulu özüm də çatdıra bilərəm" seçimini aktiv edə bilər.
  // Yango (kuryer) və mağazadan götürmə həmişə mümkündür; bunu satıcı açır.
  allowSelfDelivery Boolean        @default(false)
  // Məhsulun çəkisi (kq, bir ədəd). Yango yük limiti (50 kq) yoxlanışı üçün.
  weightKg         Float?
  bookingType      BookingType? // RESERVATION (tarix+saat) | STAY (giriş-çıxış)
  maxGuests        Int? // maksimum qonaq / nəfər sayı
  openTime         String? // rezervasiya üçün açılış saatı "10:00"
  closeTime        String? // rezervasiya üçün bağlanış saatı "23:00"
  viewCount        Int             @default(0)
  expiresAt        DateTime?
  // Biznes bağlantısı — elan bir obyektə (filiala) aiddirsə kart ödənişi mümkün olur.
  businessId       Int?
  businessObjectId Int?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  business         Business?       @relation(fields: [businessId], references: [id], onDelete: SetNull)
  businessObject   BusinessObject? @relation(fields: [businessObjectId], references: [id], onDelete: SetNull)
  messages         Message[]
  comments         Comment[]
  cartItems        CartItem[]
  orderItems       OrderItem[]
  inquiryOffers    InquiryOffer[]
  favorites        Favorite[]
  bookings         Booking[]

  @@index([userId, createdAt])
  @@index([category])
  @@index([price])
  @@index([type])
  @@index([year])
  @@index([city])
  @@index([fuelType])
  @@index([paymentType])
  @@index([businessId])
  @@index([businessObjectId])
}

enum MessageType {
  TEXT
  IMAGE
  FILE
  AUDIO // səs mesajı
  VIDEO // video mesaj (video note)
  CONTACT // paylaşılan kontakt
}

model Message {
  id             Int                  @id @default(autoincrement())
  senderId       Int
  receiverId     Int? // 1:1 mesaj üçün alıcı; qrup mesajında null
  conversationId Int? // qrup mesajı üçün; 1:1-də null
  listingId      Int?
  consultationId Int? // dolu olarsa bu mesaj "Rəy" konsultasiyasına aiddir (ayrı icon)
  content        String
  type           MessageType          @default(TEXT)
  mediaUrl       String? // yüklənmiş faylın adı (şəkil/fayl/audio/video)
  mediaName      String? // orijinal fayl adı, və ya paylaşılan kontaktın adı
  mediaMime      String?
  mediaSize      Int? // bayt
  mediaDuration  Int? // saniyə (audio/video)
  contactPhone   String? // paylaşılan kontaktın nömrəsi
  contactUserId  Int? // paylaşılan kontakt qeydiyyatlı istifadəçidirsə
  read           Boolean              @default(false)
  deliveredAt    DateTime? // qarşı tərəf onlayn olub aldı (tək ✓ → ✓✓)
  editedAt       DateTime? // redaktə olunubsa
  deletedAt      DateTime? // "hamı üçün sil" — sətir qalır, mətn boşalır
  replyToId      Int? // cavab verilən mesaj
  createdAt      DateTime             @default(now())
  sender         User                 @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiver       User?                @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)
  conversation   Conversation?        @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  listing        Listing?             @relation(fields: [listingId], references: [id], onDelete: SetNull)
  consultation   ConsultationSession? @relation(fields: [consultationId], references: [id], onDelete: SetNull)
  replyTo        Message?             @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies        Message[]            @relation("MessageReplies")
  reactions      MessageReaction[]

  @@index([senderId, receiverId])
  @@index([receiverId, read])
  @@index([conversationId])
}

// Qrup söhbəti (WhatsApp qrupu kimi). 1:1 çat bu modeldən istifadə etmir.
model Conversation {
  id          Int                  @id @default(autoincrement())
  name        String
  avatar      String?
  createdById Int
  createdAt   DateTime             @default(now())
  members     ConversationMember[]
  messages    Message[]
}

model ConversationMember {
  id             Int          @id @default(autoincrement())
  conversationId Int
  userId         Int
  role           String       @default("MEMBER") // ADMIN | MEMBER
  joinedAt       DateTime     @default(now())
  lastReadAt     DateTime? // oxunmamış say üçün
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
}

// Mesaja emoji reaksiya — hər istifadəçi bir mesaja bir emoji (WhatsApp kimi).
model MessageReaction {
  id        Int      @id @default(autoincrement())
  messageId Int
  userId    Int
  emoji     String
  createdAt DateTime @default(now())
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([messageId])
}

model Comment {
  id        Int      @id @default(autoincrement())
  userId    Int
  listingId Int
  content   String
  rating    Int?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
}

model Cart {
  id        Int        @id @default(autoincrement())
  userId    Int        @unique
  createdAt DateTime   @default(now())
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
}

// Paylaşılan səbət — istifadəçi səbəti link kimi paylaşır, linki açan şəxs
// məhsulları öz səbətinə alıb sifariş verir (məhsuldan anlayan başqasına kömək edir).
model SharedCart {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  userId    Int // yaradan
  title     String? // ixtiyari ad ("Anama hədiyyə" və s.)
  items     Json // [{ listingId, quantity }]
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model CartItem {
  id        Int     @id @default(autoincrement())
  cartId    Int
  listingId Int
  quantity  Int     @default(1)
  cart      Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([cartId, listingId])
}

model Order {
  id                  Int             @id @default(autoincrement())
  buyerId             Int
  sellerId            Int
  courierId           Int?
  status              OrderStatus     @default(PENDING)
  total               Float
  subtotal            Float? // indirim oncesi
  discountAmount      Float           @default(0)
  pointsEarned        Int             @default(0)
  pointsUsed          Int             @default(0)
  address             String?
  phone               String?
  note                String?
  deliveryType        DeliveryType    @default(DELIVERY)
  // Çatdırılma metodu (DELIVERY olduqda): kuryer (Yango) və ya satıcı özü — alıcı seçir.
  deliveryMethod      DeliveryMethod? @default(COURIER)
  deliveryFee         Float           @default(0) // Yango çatdırılma haqqı (alıcı ödəyir)
  // Biznes adına alış — canBuy səlahiyyətli işçi obyekt üçün alış edir.
  buyerObjectId       Int?
  // Təhvil kodu — alıcı ilə satıcı/kuryer arasında məhsulun düzgün təhvili üçün
  // unikal kod. Yalnız bu kod təsdiqlənəndə DELIVERED olur (səhv təhvilin qarşısını alır).
  pickupCode          String?
  // Yango (Yandex Delivery) inteqrasiyası
  yangoClaimId        String? // Yango claim id
  yangoStatus         String? // Yango status (new/accepted/performer_found/pickuped/delivered/cancelled...)
  yangoVersion        Int? // accept/cancel üçün lazım olan versiya
  yangoPrice          Float? // Yango çatdırılma qiyməti
  yangoCurrency       String?
  scheduledAt         DateTime? // ileri tarihli siparis
  paymentMethod       PaymentMethod   @default(CASH)
  paymentStatus       PaymentStatus   @default(PENDING)
  // Kapital Bank ödəniş şlüzü — kart ödənişində bir checkout-dakı bütün
  // order-lər eyni gatewayOrderId-ni paylaşır (müştəri bir dəfə ödəyir).
  gatewayOrderId      Int?
  gatewayPassword     String?
  gatewayStatus       String?
  gatewayProvider     String? // 'kapital' | 'yigim'
  gatewayRef          String? // şlüz referansı (YIĞIM: reference; Kapital: order id)
  promoCodeId         Int?
  // Referal (komissiyalı) satış
  referrerId          Int? // sifarişi yönləndirən peşəkar
  referralPercent     Float? // tətbiq olunan komissiya faizi
  referralAmount      Float? // hesablanmış komissiya məbləği
  referralVoided      Boolean         @default(false) // qaytarma/refund-da komissiya ləğv edilib
  stockRestored       Boolean         @default(false) // ödəniş uğursuz olduqda stok yalnız bir dəfə geri qaytarılır (idempotentlik)
  // Canli takip icin
  latitude            Float?
  longitude           Float?
  estimatedDeliveryAt DateTime?
  courierLat          Float?
  courierLng          Float?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  buyer               User            @relation("BuyerOrders", fields: [buyerId], references: [id], onDelete: Cascade)
  seller              User            @relation("SellerOrders", fields: [sellerId], references: [id], onDelete: Cascade)
  courier             User?           @relation("CourierOrders", fields: [courierId], references: [id], onDelete: SetNull)
  referrer            User?           @relation("ReferralOrders", fields: [referrerId], references: [id], onDelete: SetNull)
  buyerObject         BusinessObject? @relation("ObjectPurchases", fields: [buyerObjectId], references: [id], onDelete: SetNull)
  promoCode           PromoCode?      @relation(fields: [promoCodeId], references: [id], onDelete: SetNull)
  items               OrderItem[]
  returnRequests      ReturnRequest[]
  sellerRating        SellerRating?

  @@index([buyerId, createdAt])
  @@index([sellerId, createdAt])
  @@index([status])
  @@index([gatewayOrderId])
  @@index([gatewayRef])
}

model EmailVerification {
  id        Int      @id @default(autoincrement())
  userId    Int
  email     String
  code      String
  expiresAt DateTime
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// İstifadəçinin sosial media hesabları — admin tərəfindən təsdiqlənir,
// təsdiqlənənlər public profildə "✓" ilə göstərilir.
model SocialLink {
  id        Int      @id @default(autoincrement())
  userId    Int
  platform  String // instagram, facebook, tiktok, youtube, linkedin, twitter, telegram, website
  url       String
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, platform])
}

// Peşə sənədləri (diplom, sertifikat, lisenziya). AI ad-soyad uyğunluğunu yoxlayır.
model ProfessionDocument {
  id              Int                @id @default(autoincrement())
  userId          Int
  title           String // istifadəçinin verdiyi başlıq (məs. "Diplom", "Həkimlik lisenziyası")
  image           String // uploads/ faylının adı
  documentType    String? // AI: diplom / sertifikat / lisenziya
  issuer          String? // AI: kim verib
  holderName      String? // AI: sənəddəki ad-soyad
  nameMatch       Boolean            @default(false) // ad-soyad istifadəçi ilə uyğundur?
  nameMatchScore  Float? // 0..1
  professionMatch Boolean? // məsləklə uyğundur?
  confidence      Float? // 0..1
  fraudSignals    String[]           @default([])
  aiReason        String? // AI-ın qısa izahı
  isPublic        Boolean            @default(false) // public profildə görünsünmü (YES ikonu)
  status          VerificationStatus @default(PENDING) // PENDING / APPROVED / REJECTED (admin son sözü)
  createdAt       DateTime           @default(now())
  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

model OrderItem {
  id             Int             @id @default(autoincrement())
  orderId        Int
  listingId      Int
  quantity       Int
  price          Float
  title          String
  order          Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  listing        Listing         @relation(fields: [listingId], references: [id], onDelete: Cascade)
  returnRequests ReturnRequest[]
}

model ReturnRequest {
  id           Int          @id @default(autoincrement())
  orderId      Int
  orderItemId  Int?
  buyerId      Int
  sellerId     Int
  status       ReturnStatus @default(REQUESTED)
  reason       ReturnReason
  reasonText   String?
  quantity     Int
  refundAmount Float?
  sellerNote   String?
  adminNote    String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  order        Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderItem    OrderItem?   @relation(fields: [orderItemId], references: [id], onDelete: SetNull)
  buyer        User         @relation("BuyerReturns", fields: [buyerId], references: [id], onDelete: Cascade)
  seller       User         @relation("SellerReturns", fields: [sellerId], references: [id], onDelete: Cascade)
}

enum InquiryStatus {
  OPEN
  CLOSED
  ACCEPTED
  EXPIRED
}

enum OfferStatus {
  PENDING
  ACCEPTED
  REJECTED
  WITHDRAWN
}

model Inquiry {
  id            Int             @id @default(autoincrement())
  buyerId       Int
  rawText       String
  aiAnalysis    Json?
  cities        String[]        @default([])
  status        InquiryStatus   @default(OPEN)
  expiresAt     DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  buyer         User            @relation("BuyerInquiries", fields: [buyerId], references: [id], onDelete: Cascade)
  offers        InquiryOffer[]
  targetSellers InquiryTarget[]
}

model InquiryTarget {
  id        Int      @id @default(autoincrement())
  inquiryId Int
  sellerId  Int
  seen      Boolean  @default(false)
  createdAt DateTime @default(now())
  inquiry   Inquiry  @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  seller    User     @relation("TargetedInquiries", fields: [sellerId], references: [id], onDelete: Cascade)

  @@unique([inquiryId, sellerId])
}

model InquiryOffer {
  id        Int         @id @default(autoincrement())
  inquiryId Int
  sellerId  Int
  listingId Int?
  price     Float
  message   String?
  status    OfferStatus @default(PENDING)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  inquiry   Inquiry     @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  seller    User        @relation("SellerOffers", fields: [sellerId], references: [id], onDelete: Cascade)
  listing   Listing?    @relation(fields: [listingId], references: [id], onDelete: SetNull)
}

// ==================== BOLT FOOD BENZERI MODELLER ====================

model Favorite {
  id        Int      @id @default(autoincrement())
  userId    Int
  listingId Int
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([userId, listingId])
}

model SavedAddress {
  id        Int      @id @default(autoincrement())
  userId    Int
  label     String // "Ev", "Is", "Anne evi"
  address   String
  phone     String?
  latitude  Float?
  longitude Float?
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PromoCode {
  id             Int       @id @default(autoincrement())
  code           String    @unique
  description    String?
  discountType   String // "PERCENT" veya "FIXED"
  discountValue  Float
  minOrderAmount Float?
  maxDiscount    Float?
  usageLimit     Int?
  usageCount     Int       @default(0)
  validFrom      DateTime  @default(now())
  validUntil     DateTime?
  active         Boolean   @default(true)
  createdAt      DateTime  @default(now())
  orders         Order[]
}

model SellerRating {
  id        Int      @id @default(autoincrement())
  orderId   Int      @unique
  sellerId  Int
  buyerId   Int
  rating    Int // 1-5
  comment   String?
  createdAt DateTime @default(now())
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  seller    User     @relation("SellerRatings", fields: [sellerId], references: [id], onDelete: Cascade)
  buyer     User     @relation("BuyerRatings", fields: [buyerId], references: [id], onDelete: Cascade)

  @@index([sellerId])
}

model SellerVerification {
  id              Int                @id @default(autoincrement())
  userId          Int                @unique
  idImageFront    String
  idImageBack     String?
  taxId           String
  iban            String?
  businessName    String?
  status          VerificationStatus @default(PENDING)
  rejectionReason String?
  submittedAt     DateTime           @default(now())
  reviewedAt      DateTime?
  reviewedBy      Int?
  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  type      String // "ORDER", "MESSAGE", "INQUIRY", "PROMO", "SYSTEM"
  title     String
  body      String
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@index([userId, createdAt])
}

// ==================== BİZNES HESABI ====================
// Bir istifadəçi çoxlu biznes əlavə edə bilər. Biznes admin tərəfindən
// təsdiqlənəndə həmin biznesə bağlı elanlar KART ödənişi qəbul edir
// (VÖEN + bank hesabı olmadan bank pul köçürə bilmir).

enum BusinessKind {
  LEGAL // Hüquqi şəxs
  PHYSICAL // Fiziki şəxs
}

enum BusinessProofType {
  TAX_DOC // Vergi qeydiyyatını təsdiq edən sənəd
  POWER_OF_ATTORNEY // Etibarnamə (+ şirkət sənədi)
}

model Business {
  id              Int                @id @default(autoincrement())
  userId          Int
  kind            BusinessKind       @default(PHYSICAL)
  proofType       BusinessProofType  @default(TAX_DOC)
  name            String
  voen            String
  ownerName       String
  founderName     String
  phone           String? // şirkət telefonu
  status          VerificationStatus @default(PENDING)
  isActive        Boolean            @default(true) // sahibi tərəfindən aktiv/deaktiv
  rejectionReason String?
  createdAt       DateTime           @default(now())
  reviewedAt      DateTime?

  // KYC sənədləri (fayl adları)
  taxDocImage          String? // vergi qeydiyyatı sənədi (TAX_DOC)
  companyDocImage      String? // şirkət sənədi (POWER_OF_ATTORNEY halında)
  powerOfAttorneyImage String? // etibarnamə
  bankDocImage         String? // (köhnə) tək bank sənədi
  bankDocImages        String[] @default([]) // bir neçə bank hesabı sənədi (IBAN-lar AI ilə oxunur)
  idCardImage          String? // şəxsiyyət vəsiqəsi
  selfieImage          String? // üz tanıma üçün selfie (admin əllə yoxlayır)

  // Claude AI sənəd yoxlaması (avtomatik təsdiq üçün)
  aiAuthorized   Boolean? // profil sahibi rəhbər/etibarnaməli olaraq təsdiqləndi?
  aiVoenMatch    Boolean? // sənədlərdəki VÖEN forma ilə uyğun?
  aiConfidence   Float? // 0..1
  aiFraudSignals String[] @default([])
  aiReason       String? // AI-ın qısa izahı
  autoApproved   Boolean  @default(false) // AI tərəfindən avtomatik təsdiqləndi?

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  objects  BusinessObject[]
  listings Listing[]
  banks    BankAccount[]
  members  BusinessMember[]

  @@index([userId])
  @@index([status])
}

model BankAccount {
  id         Int      @id @default(autoincrement())
  businessId Int
  iban       String // bank hesabı / IBAN
  title      String? // bank adı / qeyd
  isActive   Boolean  @default(true)
  isPrimary  Boolean  @default(false) // ödəniş bu hesab üzərindən gedir ("yes" seçilən)
  docImage   String? // bu hesabın aid olduğu bank sənədi (fayl adı)
  createdAt  DateTime @default(now())
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
}

model BusinessObject {
  id              Int              @id @default(autoincrement())
  businessId      Int
  name            String // obyekt adı (məs. "Aptek №3")
  phone           String? // obyekt telefonu
  activityAreas   String[]         @default([]) // fəaliyyət sahələri (16 kateqoriya adları)
  isActive        Boolean          @default(true) // aktiv/passiv
  address         String
  city            String?
  latitude        Float?
  longitude       Float?
  createdAt       DateTime         @default(now())
  referralEnabled Boolean          @default(false) // referal (komissiyalı) satışa icazə
  business        Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  listings        Listing[]
  managers        BusinessMember[]
  referralRules   ReferralRule[]
  purchases       Order[]          @relation("ObjectPurchases") // bu obyekt adına edilən alışlar

  @@index([businessId])
}

// Referal qaydası: mağaza (obyekt) hansı ixtisasa hansı faizlə komissiya verir + sənəd tələbi.
model ReferralRule {
  id                Int            @id @default(autoincrement())
  objectId          Int
  profession        String // İxtisas adı (məs. "Həkim")
  commissionPercent Float // komissiya faizi (0..100)
  requiredDoc       String         @default("NONE") // NONE | DIPLOMA | CV | ANY
  object            BusinessObject @relation(fields: [objectId], references: [id], onDelete: Cascade)

  @@index([objectId])
}

// Peşəkarın yaratdığı referal səbət (link) — alıcıya göndərilir.
model ReferralCart {
  id         Int      @id @default(autoincrement())
  token      String   @unique
  referrerId Int
  objectId   Int
  businessId Int
  percent    Float // bu referala tətbiq olunan komissiya faizi
  items      Json // [{listingId, quantity}]
  createdAt  DateTime @default(now())
  referrer   User     @relation("ReferralCarts", fields: [referrerId], references: [id], onDelete: Cascade)

  @@index([referrerId])
}

// Səlahiyyət vermə — sahibi başqa istifadəçiyə bütün biznesin və ya
// konkret obyektin idarəsini verə bilər (objectId null = bütün biznes).
// İşçilik statusu — iki tərəfli sorğu/qəbul axını.
enum MemberStatus {
  PENDING_BUSINESS // istifadəçi "mən sizin işçinizəm" sorğusu göndərib — biznes sahibi təsdiqləməlidir
  PENDING_USER // biznes dəvət göndərib — istifadəçi təsdiqləməlidir
  ACTIVE // rəsmi işçi
}

model BusinessMember {
  id         Int             @id @default(autoincrement())
  businessId Int
  userId     Int
  objectId   Int?
  status     MemberStatus    @default(ACTIVE) // köhnə sətirlər aktiv qalır
  // Sahibin işçiyə verdiyi səlahiyyətlər:
  canSell    Boolean         @default(true) // obyektin məhsullarını satmaq (elan + sifariş idarəsi)
  canBuy     Boolean         @default(false) // biznes adına məhsul almaq
  createdAt  DateTime        @default(now())
  business   Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user       User            @relation("BusinessMemberships", fields: [userId], references: [id], onDelete: Cascade)
  object     BusinessObject? @relation(fields: [objectId], references: [id], onDelete: Cascade)

  @@unique([businessId, userId, objectId])
  @@index([userId])
  @@index([businessId, status])
}

// ── Rəy (peşəkar konsultasiyası) ──────────────────────────────────────────────
enum ConsultationStatus {
  REQUESTED // alıcı sorğu göndərib, ödəniş gözlənilir
  PENDING_VOEN // peşəkarın VÖEN-i yoxdur → aktivləşə bilmir
  PAID // ödənilib, peşəkar başlatmağı gözləyir
  ACTIVE // sayğac işləyir
  PAUSED // peşəkar dayandırıb
  ENDED // vaxt bitib və ya bağlanıb
}

// Peşəkarın "Rəy" təklifi — müddət + qiymət (profilə bağlı, məhsul elanı deyil).
model ConsultationOffer {
  id                   Int                   @id @default(autoincrement())
  userId               Int
  title                String?
  description          String? // peşəkarın konsultasiya haqqında qeydi/təsviri
  durationMinutes      Int                   @default(30)
  price                Float
  active               Boolean               @default(true)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  user                 User                  @relation("UserConsultationOffer", fields: [userId], references: [id], onDelete: Cascade)
  consultationSessions ConsultationSession[]

  @@index([userId])
}

// Bir konsultasiya seansı — sayğac (start/pause) və ödəniş vəziyyəti.
model ConsultationSession {
  id              Int                @id @default(autoincrement())
  buyerId         Int
  professionalId  Int
  offerId         Int?
  title           String?
  price           Float
  blockSeconds    Int                @default(0) // bir ödənişin verdiyi vaxt (reaktivasiya/top-up üçün)
  durationSeconds Int // ümumi alınan vaxt (saniyə) — top-up ilə artır
  consumedSeconds Int                @default(0)
  runningSince    DateTime? // ACTIVE olduqda dolu; pauza/bitmədə null
  status          ConsultationStatus @default(REQUESTED)
  paymentStatus   String             @default("UNPAID") // UNPAID/PAID
  gatewayProvider String?
  gatewayRef      String?
  gatewayOrderId  Int?
  gatewayPassword String?
  settledRefs     String[]           @default([]) // top-up idempotentliyi: tətbiq olunmuş ödəniş referansları
  rated           Boolean            @default(false)
  complaints      Complaint[]
  ratingStars     Int?
  ratingLike      Boolean?
  ratingText      String?
  createdAt       DateTime           @default(now())
  startedAt       DateTime?
  endedAt         DateTime?
  buyer           User               @relation("ConsultationBuyer", fields: [buyerId], references: [id], onDelete: Cascade)
  professional    User               @relation("ConsultationProfessional", fields: [professionalId], references: [id], onDelete: Cascade)
  offer           ConsultationOffer? @relation(fields: [offerId], references: [id], onDelete: SetNull)
  messages        Message[]

  @@index([buyerId])
  @@index([professionalId])
}

// ── Şikayət (profil / Rəy konsultasiyası) ─────────────────────────────────────
enum ComplaintStatus {
  OPEN
  REVIEWING
  RESOLVED
  REJECTED
}

model Complaint {
  id             Int                  @id @default(autoincrement())
  complainantId  Int
  targetUserId   Int
  consultationId Int? // dolu olarsa konkret seansa bağlıdır
  category       String // TIME_WASTED / FRAUD / RUDE / FAKE_INFO / OTHER
  description    String
  status         ComplaintStatus      @default(OPEN)
  resolution     String? // REFUNDED / WARNED / SUSPENDED / NO_ACTION / REJECTED
  adminNote      String?
  resolvedById   Int?
  createdAt      DateTime             @default(now())
  resolvedAt     DateTime?
  complainant    User                 @relation("ComplaintsMade", fields: [complainantId], references: [id], onDelete: Cascade)
  target         User                 @relation("ComplaintsAgainst", fields: [targetUserId], references: [id], onDelete: Cascade)
  consultation   ConsultationSession? @relation(fields: [consultationId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([targetUserId])
  @@index([consultationId])
}

// Bron / rezervasiya — qonaq elanı (restoran/otel/məkan) bron edir, sahib təsdiqləyir.
model Booking {
  id           Int           @id @default(autoincrement())
  listingId    Int
  guestId      Int // bron edən
  hostId       Int // elan sahibi
  type         BookingType
  date         DateTime? // REZERVASİYA: gün
  time         String? // REZERVASİYA: saat "19:30"
  checkIn      DateTime? // GECƏLƏMƏ: giriş
  checkOut     DateTime? // GECƏLƏMƏ: çıxış
  nights       Int? // GECƏLƏMƏ: gecə sayı
  guests       Int           @default(1) // qonaq / nəfər sayı
  rooms        Int? // GECƏLƏMƏ: otaq sayı
  totalPrice   Float? // təxmini cəm (məlumat üçün)
  note         String?
  contactName  String?
  contactPhone String
  status       BookingStatus @default(PENDING)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  listing      Listing       @relation(fields: [listingId], references: [id], onDelete: Cascade)
  guest        User          @relation("GuestBookings", fields: [guestId], references: [id], onDelete: Cascade)
  host         User          @relation("HostBookings", fields: [hostId], references: [id], onDelete: Cascade)

  @@index([guestId, createdAt])
  @@index([hostId, createdAt])
  @@index([listingId])
  @@index([status])
}

// Şəxsi kontakt kitabçası — istifadəçi istədiyi nömrəni əlavə edir
// (gələcəkdə telefon kontaktlarından sinxron olunacaq — bulk endpoint hazırdır).
// Nömrə platformada qeydiyyatlıdırsa, siyahıda profil linki göstərilir.
model Contact {
  id          Int      @id @default(autoincrement())
  ownerId     Int
  name        String
  phone       String // istifadəçinin yazdığı format
  phoneDigits String // yalnız rəqəmlər — qeydiyyatlı istifadəçi ilə uyğunlaşdırma üçün
  createdAt   DateTime @default(now())
  owner       User     @relation("OwnContacts", fields: [ownerId], references: [id], onDelete: Cascade)

  @@unique([ownerId, phoneDigits])
  @@index([ownerId])
}
